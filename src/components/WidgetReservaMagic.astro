---
export interface Props {
  hotel?: string;      // texto libre para el input "destino"
  marca?: string;      // valor de selectmarcas (opcional). Ej: costa_world | magic_natura | ...
  compacto?: boolean;  // versión horizontal 1 línea
}
const { hotel = "", marca = "", compacto = false } = Astro.props;
const uid = `wm-${Math.random().toString(36).slice(2, 8)}`;
---
<form
  class:list={["widget-reserva-magic", { compacto }]}
  method="post"
  action="https://reservas.magichotelgroup.com/bookcore/v4/search-dispo.htm"
  target="_blank"
  data-uid={uid}
  onsubmit="return window.__wmReservaSubmit && window.__wmReservaSubmit(this);"
>
  <input type="hidden" name="codpromo" value="MAGICLOSFAMILUKIS" />
  <input type="hidden" name="destino" value={hotel} />
  <input type="hidden" name="coddestino" value="" />
  <input type="hidden" name="selectmarcas" value={marca} />
  <input type="hidden" name="entrada" value="" />
  <input type="hidden" name="salida" value="" />
  <input type="hidden" name="occupancies" value="" />

  <div class="wm-row wm-dates">
    <label>
      <span>Entrada</span>
      <input type="date" class="wm-in-entrada" required />
    </label>
    <label>
      <span>Salida</span>
      <input type="date" class="wm-in-salida" required />
    </label>
  </div>

  <div class="wm-row wm-people">
    <label>
      <span>Adultos</span>
      <select class="wm-in-adults">
        <option value="1">1</option>
        <option value="2" selected>2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5</option>
      </select>
    </label>
    <label>
      <span>Niños</span>
      <select class="wm-in-children">
        <option value="0" selected>0</option>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
      </select>
    </label>
    <label class="wm-ages" hidden>
      <span>Edades <small>(coma)</small></span>
      <input type="text" class="wm-in-ages" placeholder="8, 10" pattern="[0-9,\s]*" />
    </label>
  </div>

  <button type="submit" class="wm-cta">
    Buscar con 3% de descuento
    <span class="wm-cta-sub">Código MAGICLOSFAMILUKIS aplicado</span>
  </button>

  <p class="wm-note">Vas al buscador oficial de Magic Hotels con nuestro código aplicado. Sin banners de terceros.</p>
</form>

<script is:inline>
(function () {
  if (window.__wmReservaSubmit) return;

  function fmt(dateStr) {
    if (!dateStr) return "";
    const [y, m, d] = dateStr.split("-");
    return `${d}/${m}/${y}`;
  }

  function initForm(f) {
    const kids = f.querySelector(".wm-in-children");
    const ages = f.querySelector(".wm-ages");
    if (kids && ages) {
      const toggle = () => { ages.hidden = parseInt(kids.value, 10) === 0; };
      toggle();
      kids.addEventListener("change", toggle);
    }
    const entrada = f.querySelector(".wm-in-entrada");
    const salida = f.querySelector(".wm-in-salida");
    if (entrada && salida) {
      const today = new Date();
      const tomorrow = new Date(today.getTime() + 86400000);
      entrada.min = today.toISOString().slice(0, 10);
      salida.min = tomorrow.toISOString().slice(0, 10);
      entrada.addEventListener("change", () => {
        if (entrada.value) {
          const next = new Date(new Date(entrada.value).getTime() + 86400000);
          salida.min = next.toISOString().slice(0, 10);
          if (!salida.value || salida.value <= entrada.value) {
            salida.value = next.toISOString().slice(0, 10);
          }
        }
      });
    }
  }

  window.__wmReservaSubmit = function (f) {
    const entrada = f.querySelector(".wm-in-entrada").value;
    const salida = f.querySelector(".wm-in-salida").value;
    if (!entrada || !salida) return false;
    if (salida <= entrada) { alert("La salida debe ser posterior a la entrada"); return false; }

    const adults = parseInt(f.querySelector(".wm-in-adults").value, 10);
    const kidsN = parseInt(f.querySelector(".wm-in-children").value, 10);
    const agesRaw = (f.querySelector(".wm-in-ages").value || "").trim();
    const ages = kidsN > 0
      ? (agesRaw ? agesRaw.split(/[,\s]+/).filter(Boolean).map(n => parseInt(n, 10)).filter(n => !isNaN(n)) : Array(kidsN).fill(6))
      : [];

    f.querySelector("[name=entrada]").value = fmt(entrada);
    f.querySelector("[name=salida]").value = fmt(salida);
    f.querySelector("[name=occupancies]").value = JSON.stringify([{ adults, children: kidsN, ages }]);

    if (window.gtag) {
      window.gtag("event", "widget_reserva_magic", {
        hotel: f.querySelector("[name=destino]").value || "sin-hotel",
        marca: f.querySelector("[name=selectmarcas]").value || "sin-marca",
        adults, children: kidsN, entrada, salida
      });
    }
    return true;
  };

  document.querySelectorAll(".widget-reserva-magic").forEach(initForm);
})();
</script>

<style is:global>
  .widget-reserva-magic{
    background:#fff;
    border:1px solid rgba(0,0,0,.08);
    border-radius:14px;
    padding:1.5rem 1.5rem 1.25rem;
    box-shadow:0 8px 30px rgba(0,0,0,.06);
    max-width:760px;
    margin:1.5rem auto;
    font-family:inherit;
    color:#111;
  }
  .widget-reserva-magic .wm-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:.85rem;
    margin-bottom:.85rem;
  }
  .widget-reserva-magic .wm-people{
    grid-template-columns:1fr 1fr 2fr;
  }
  .widget-reserva-magic label{
    display:flex;
    flex-direction:column;
    gap:.25rem;
    font-size:.82rem;
    color:#555;
    font-weight:500;
  }
  .widget-reserva-magic input,
  .widget-reserva-magic select{
    font:inherit;
    color:#111;
    padding:.6rem .75rem;
    border:1px solid #d3d7de;
    border-radius:8px;
    background:#fafbfc;
    outline:none;
    transition:border-color .15s,background .15s;
  }
  .widget-reserva-magic input:focus,
  .widget-reserva-magic select:focus{
    border-color:#e50914;
    background:#fff;
  }
  .widget-reserva-magic .wm-cta{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:.15rem;
    width:100%;
    padding:.9rem 1rem;
    background:#e50914;
    color:#fff;
    border:0;
    border-radius:10px;
    font-weight:700;
    font-size:1rem;
    cursor:pointer;
    margin-top:.4rem;
    transition:background .15s,transform .05s;
    line-height:1.2;
  }
  .widget-reserva-magic .wm-cta:hover{ background:#b3060f; }
  .widget-reserva-magic .wm-cta:active{ transform:translateY(1px); }
  .widget-reserva-magic .wm-cta-sub{
    font-size:.72rem;
    font-weight:500;
    opacity:.88;
    letter-spacing:.02em;
  }
  .widget-reserva-magic .wm-note{
    font-size:.72rem;
    color:#888;
    text-align:center;
    margin:.65rem 0 0;
  }
  @media (max-width:640px){
    .widget-reserva-magic{ padding:1.15rem }
    .widget-reserva-magic .wm-people{ grid-template-columns:1fr 1fr; }
    .widget-reserva-magic .wm-ages{ grid-column:span 2 }
  }
  .widget-reserva-magic.compacto{
    padding:.85rem 1rem;
  }
  .widget-reserva-magic.compacto .wm-row{ margin-bottom:.55rem; }
</style>
