---
export interface Props {
  label?: string;
  sub?: string;
  variant?: "default" | "light";
}
const {
  label = "Reservar Magic con descuento",
  sub = "Código Familukis aplicado — descubre el precio final",
  variant = "default",
} = Astro.props;
const PROXY = "https://magic-reservas.plural-soldier.workers.dev/";
const BREVO_ACTION = "https://9ab7b963.sibforms.com/serve/MUIFAPXRQ-W__aWgVPRXoZ3tSR6ujJVM1joRf9CcdjCGJlw5rDRzzzXwHm4vwaMrW_j38TfKNIcDz4tW6VuUJDPyuW7Vb8rEzobYl-TWAAtehqCnIHRp_9m8IWvqIczCTnyuAWQOx6BkPZLR9xBwChW60CIrSfHzjrG9bHL1m2OSTMJc1eJiAP84IzvbVhM7YeFcT22FtRYNkY9hDg==";
const uid = `wm-${Math.random().toString(36).slice(2, 8)}`;
---
<div class:list={["widget-reserva-magic", variant]} data-uid={uid}>
  <a
    href={PROXY}
    target="_blank"
    rel="sponsored noopener"
    class="wm-cta"
    onclick="return window.__wmReservaClick && window.__wmReservaClick(this);"
  >
    <span class="wm-cta-icon" aria-hidden="true">
      <img src="/logos/magic-exploradores.webp" alt="" width="44" height="44" loading="lazy" />
    </span>
    <span class="wm-cta-content">
      <span class="wm-cta-label">{label}</span>
      <span class="wm-cta-sub">{sub}</span>
    </span>
    <span class="wm-cta-arrow" aria-hidden="true">→</span>
  </a>

  <details class="wm-lead">
    <summary>📧 Guardar mi búsqueda y recibir novedades (opcional)</summary>
    <div class="wm-lead-body">
      <input type="email" class="wm-in-email" placeholder="tu@email.com" autocomplete="email" />
      <label class="wm-optin">
        <input type="checkbox" class="wm-in-optin" />
        <span>Acepto recibir contenido, planes, escapadas y ofertas de Familukis. <a href="/privacidad" target="_blank">Política de privacidad</a>.</span>
      </label>
    </div>
  </details>

  <iframe name={`brevo-lead-${uid}`} style="display:none;width:0;height:0;border:0" aria-hidden="true" title=""></iframe>
</div>

<script is:inline>
(function () {
  if (window.__wmReservaClick) return;

  window.__wmReservaClick = function (link) {
    var wrap = link.closest('.widget-reserva-magic');
    var emailInp = wrap && wrap.querySelector('.wm-in-email');
    var optinInp = wrap && wrap.querySelector('.wm-in-optin');
    if (emailInp && optinInp && emailInp.value && optinInp.checked && /@/.test(emailInp.value)) {
      try {
        var leadForm = document.createElement('form');
        leadForm.action = "https://9ab7b963.sibforms.com/serve/MUIFAPXRQ-W__aWgVPRXoZ3tSR6ujJVM1joRf9CcdjCGJlw5rDRzzzXwHm4vwaMrW_j38TfKNIcDz4tW6VuUJDPyuW7Vb8rEzobYl-TWAAtehqCnIHRp_9m8IWvqIczCTnyuAWQOx6BkPZLR9xBwChW60CIrSfHzjrG9bHL1m2OSTMJc1eJiAP84IzvbVhM7YeFcT22FtRYNkY9hDg==";
        leadForm.method = 'POST';
        leadForm.target = wrap.querySelector('iframe[name^="brevo-lead-"]').name;
        leadForm.style.display = 'none';
        var fields = {
          EMAIL: emailInp.value,
          OPT_IN: '1',
          locale: 'es',
          html_type: 'simple',
          FUENTE: 'widget-reserva-magic',
          email_address_check: '', // honeypot antibot (Brevo lo requiere vacío)
        };
        Object.keys(fields).forEach(function(k){
          var i = document.createElement('input');
          i.type = 'hidden'; i.name = k; i.value = fields[k];
          leadForm.appendChild(i);
        });
        document.body.appendChild(leadForm);
        leadForm.submit();
      } catch(e) {}
    }
    if (window.gtag) {
      window.gtag("event", "widget_reserva_magic", {
        lead_captured: !!(emailInp && emailInp.value && optinInp && optinInp.checked)
      });
    }
    return true;
  };
})();
</script>

<style is:global>
  .widget-reserva-magic{
    max-width:520px;
    margin:1.5rem auto;
    font-family:inherit;
  }
  .widget-reserva-magic .wm-cta{
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:.7rem;
    width:100%;
    padding:1.1rem 1.4rem;
    background:linear-gradient(135deg,#e50914 0%,#b3060f 100%);
    color:#fff;
    border:0;
    border-radius:8px;
    font-weight:700;
    font-size:1.02rem;
    text-decoration:none;
    text-align:left;
    cursor:pointer;
    transition:transform .15s ease, box-shadow .15s ease, background .15s;
    line-height:1.25;
    box-sizing:border-box;
    box-shadow:0 6px 20px rgba(229,9,20,.25);
    letter-spacing:-.01em;
  }
  .widget-reserva-magic .wm-cta:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 28px rgba(229,9,20,.4);
  }
  .widget-reserva-magic .wm-cta:active{ transform:translateY(0); }
  .widget-reserva-magic .wm-cta-icon{
    flex-shrink:0;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:52px; height:52px;
    background:#fff;
    border-radius:50%;
    padding:4px;
    box-sizing:border-box;
  }
  .widget-reserva-magic .wm-cta-icon img{
    width:100%; height:100%;
    object-fit:contain;
    display:block;
  }
  .widget-reserva-magic .wm-cta-label{
    display:block;
    font-size:1rem;
    line-height:1.25;
  }
  .widget-reserva-magic .wm-cta-sub{
    display:block;
    font-size:.72rem;
    font-weight:500;
    opacity:.85;
    letter-spacing:.01em;
    margin-top:.15rem;
    text-transform:none;
  }
  .widget-reserva-magic .wm-cta-content{
    display:flex;
    flex-direction:column;
    min-width:0;
    flex:1;
  }
  .widget-reserva-magic .wm-cta-arrow{
    font-size:1.4rem;
    flex-shrink:0;
    opacity:.9;
    transition:transform .15s;
  }
  .widget-reserva-magic .wm-cta:hover .wm-cta-arrow{ transform:translateX(4px); }

  .widget-reserva-magic .wm-lead{
    margin-top:.7rem;
  }
  .widget-reserva-magic .wm-lead summary{
    cursor:pointer;
    font-size:.78rem;
    color:rgba(255,255,255,.55);
    font-weight:500;
    list-style:none;
    padding:.35rem 0;
    text-align:center;
    transition:color .15s;
  }
  .widget-reserva-magic .wm-lead summary:hover{ color:rgba(255,255,255,.8); }
  .widget-reserva-magic .wm-lead summary::-webkit-details-marker{display:none;}
  .widget-reserva-magic .wm-lead-body{
    display:flex;
    flex-direction:column;
    gap:.55rem;
    margin-top:.5rem;
    padding:.9rem;
    background:rgba(255,255,255,.04);
    border:1px solid rgba(255,255,255,.08);
    border-radius:8px;
  }
  .widget-reserva-magic .wm-in-email{
    font:inherit;
    padding:.6rem .8rem;
    border:1px solid rgba(255,255,255,.15);
    border-radius:6px;
    background:rgba(0,0,0,.3);
    color:#fff;
    outline:none;
    transition:border-color .15s;
  }
  .widget-reserva-magic .wm-in-email::placeholder{ color:rgba(255,255,255,.35); }
  .widget-reserva-magic .wm-in-email:focus{ border-color:#e50914; background:rgba(0,0,0,.5); }
  .widget-reserva-magic .wm-optin{
    display:flex;
    align-items:flex-start;
    gap:.5rem;
    font-size:.72rem;
    color:rgba(255,255,255,.55);
    line-height:1.5;
    cursor:pointer;
  }
  .widget-reserva-magic .wm-optin input{
    margin-top:2px;
    accent-color:#e50914;
    flex-shrink:0;
  }
  .widget-reserva-magic .wm-optin a{ color:#e50914; text-decoration:underline; }

  /* Variante light (para páginas con fondo claro tipo /reservar/) */
  .widget-reserva-magic.light .wm-lead summary{ color:#666; }
  .widget-reserva-magic.light .wm-lead summary:hover{ color:#111; }
  .widget-reserva-magic.light .wm-lead-body{
    background:rgba(0,0,0,.02);
    border-color:rgba(0,0,0,.08);
  }
  .widget-reserva-magic.light .wm-in-email{
    background:#fff;
    border-color:#d3d7de;
    color:#111;
  }
  .widget-reserva-magic.light .wm-in-email::placeholder{ color:#aaa; }
  .widget-reserva-magic.light .wm-optin{ color:#666; }
</style>
