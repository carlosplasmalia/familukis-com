function bossHp(base){ return base + lap*2; }

// ── MUNDO 1: ROBOT GUARDIÁN (mecánica clásica de plataformas: onda sísmica al
//    aterrizar, bombas en arco y embestida que acaba estrellada → písalo) ──
function startBossRobot() {
  state=ST.BOSS;
  RB={ phase:'enter', t:0, x:W+180, y:GROUND-170, hp:bossHp(3), maxHp:bossHp(3),
       af:0, stun:0, hitFlash:0, cyc:0, thrown:0, waves:[], bombs:[], bvx:0,
       jx0:0, jy0:0, jxT:0, jT:42 };
  FB=null; GB=null;
  obstacles=[]; coinItems=[]; gemItems=[]; powerUps=[]; robotEv=null;
  AudioMan.sfx('robot-aparece');
  AudioMan.music('musica-ingame', 1.14);
}
function robotStomped() {
  const R=RB;
  stompBounce();
  R.hp--; R.hitFlash=10;
  burst(R.x, R.y-40, '#66eaff', 16);
  popup(R.x, R.y-110, '¡GOLPE!', '#7CFC00', 26);
  if (R.hp<=0) { R.phase='dying'; R.t=0; R.waves=[]; R.bombs=[]; AudioMan.sfx('powerup-explosion'); }
  else { R.phase='enter'; R.t=0; }
}
function updateBossRobot() {
  const R=RB; R.t++;
  if (R.t%6===0) R.af=(R.af+1)%8;
  if (R.hitFlash>0) R.hitFlash--;
  runnerPhysics();
  const pr=playerRect();
  const rage = R.hp<=Math.max(1, R.maxHp*0.4);   // furia con poca vida

  // ondas sísmicas: recorren el suelo hacia ti → sáltalas
  for (const wv of R.waves) {
    if (wv.d>0) { wv.d--; continue; }
    wv.x += wv.vx;
    if (overlaps(pr.x,pr.y,pr.w,pr.h, wv.x-16,GROUND-44,32,44, 4)) { playerHit(); wv.x=-999; }
  }
  R.waves=R.waves.filter(wv=>wv.x>-60);

  // bombas en arco: caen donde estás → salta en el momento justo
  for (const bm of R.bombs) {
    bm.t++;
    if (!bm.boom) {
      bm.x+=bm.vx; bm.vy+=bm.g; bm.y+=bm.vy;
      if (bm.t%7===0) bm.af=(bm.af+1)%4;
      if (overlaps(pr.x,pr.y,pr.w,pr.h, bm.x-14,bm.y-14,28,28, 4)) { playerHit(); bm.boom=true; bm.bt=0; }
      else if (bm.y>=GROUND-12) {
        bm.boom=true; bm.bt=0;
        fx('explosion', bm.x, GROUND-26); shake(6); AudioMan.sfx('cannon',{vol:0.5});
      }
    } else {
      bm.bt++;
      if (bm.bt<14 && overlaps(pr.x,pr.y,pr.w,pr.h, bm.x-34,GROUND-56,68,56, 4)) playerHit();
    }
  }
  R.bombs=R.bombs.filter(bm=>!bm.boom || bm.bt<16);

  if (R.phase==='enter') {
    R.x += (W-190-R.x)*0.06;
    R.y += (GROUND-170-R.y)*0.08;
    if (Math.abs(R.x-(W-190))<5) { R.phase='idle'; R.t=0; }
  }
  else if (R.phase==='idle') {
    R.y = GROUND-170+Math.sin(R.t*0.05)*26;
    if (R.t > (rage?40:62)) {
      const atk=['quake','bombs','charge'][R.cyc%3]; R.cyc++;
      R.t=0;
      if (atk==='quake') {
        R.phase='quakePrep';
        popup(W/2, H*0.32, '¡ONDA SÍSMICA! ¡SÁLTALA!', '#FFDC00', 26);
        AudioMan.sfx('robot-carga');
      } else if (atk==='bombs') {
        R.phase='bombs'; R.thrown=0;
        popup(W/2, H*0.32, '¡BOMBAS! ¡SALTA EN EL MOMENTO JUSTO!', '#FFDC00', 24);
        AudioMan.sfx('robot-carga');
      } else {
        R.phase='chargePrep';
        popup(W/2, H*0.32, '¡¡EMBISTE!! ¡SALTA POR ENCIMA!', '#FF851B', 28);
        AudioMan.sfx('robot-carga');
      }
    }
  }
  else if (R.phase==='quakePrep') {
    R.y = GROUND-170+Math.sin(R.t*0.8)*4;   // tiembla antes de saltar
    if (R.t>=32) {
      R.phase='quakeJump'; R.t=0;
      R.jx0=R.x; R.jy0=R.y;
      R.jxT=Math.min(W-210, Math.max(PX+190, P.x+210));
      R.jT=rage?36:44;
    }
  }
  else if (R.phase==='quakeJump') {
    const p=Math.min(1, R.t/R.jT);
    R.x = R.jx0+(R.jxT-R.jx0)*p;
    R.y = (R.jy0+(GROUND-90-R.jy0)*p) - 250*4*p*(1-p);
    if (R.t>=R.jT) {
      R.phase='landed'; R.t=0;
      R.y=GROUND-90;
      shake(14); AudioMan.sfx('powerup-explosion');
      fx('explosion', R.x-75, GROUND-30); fx('explosion', R.x+75, GROUND-30);
      burst(R.x, GROUND-12, '#ffcc66', 18);
      R.waves.push({ x:R.x-85, vx:-(6.2+lap*0.8), d:0 });
      if (rage) R.waves.push({ x:R.x-85, vx:-(6.2+lap*0.8), d:26 });
    }
  }
  else if (R.phase==='landed') {
    if (R.t>(rage?40:56)) { R.phase='enter'; R.t=0; }
  }
  else if (R.phase==='bombs') {
    R.y = GROUND-190+Math.sin(R.t*0.08)*14;
    const every=rage?26:34, total=rage?4:3;
    if (R.t%every===8 && R.thrown<total) {
      R.thrown++;
      const N=52+(Math.random()*16|0), g=GRAVITY*0.42;
      const tx=P.x+20+(Math.random()*90-30);
      const vx=(tx-(R.x-40))/N;
      const vy=((GROUND-14)-(R.y-40))/N - 0.5*g*(N-1);
      R.bombs.push({ x:R.x-40, y:R.y-40, vx, vy, g, t:0, af:0, boom:false, bt:0 });
      fx('warning', tx, GROUND-70, {life:44});
      AudioMan.sfx('cannon',{vol:0.55});
    }
    if (R.thrown>=total && R.bombs.length===0) { R.phase='idle'; R.t=0; }
  }
  else if (R.phase==='chargePrep') {
    R.y += ((GROUND-90)-R.y)*0.15;   // baja al suelo y coge carrerilla
    R.x += ((W-150)-R.x)*0.1;
    if (R.t%5===0) burst(R.x+62, GROUND-28, '#cccccc', 3);
    if (R.t>=50) { R.phase='charge'; R.t=0; AudioMan.sfx('robot-rayo'); }
  }
  else if (R.phase==='charge') {
    R.y=GROUND-90;
    R.x -= (10.5+lap*1.2)*(rage?1.25:1);
    if (R.t%3===0) burst(R.x+72, GROUND-24, '#ffaa44', 4);
    // embiste agachado: hitbox baja → se salta por encima
    if (overlaps(pr.x,pr.y,pr.w,pr.h, R.x-66,GROUND-128,132,118, 8)) playerHit();
    if (R.x<=92) {
      // se estrella contra el borde y REBOTA hacia ti aturdido: tu momento
      R.phase='stunned'; R.t=0; R.stun=rage?150:210; R.bvx=5.5;
      shake(16); AudioMan.sfx('powerup-explosion');
      fx('explosion', 46, GROUND-120); fx('explosion', 74, GROUND-56);
      popup(R.x+90, R.y-130, '¡AHORA! ¡SALTA ENCIMA!', '#7CFC00', 24);
    }
  }
  else if (R.phase==='stunned') {
    R.y=GROUND-90;
    if (R.bvx>0) { R.x+=R.bvx; R.bvx*=0.86; if (R.bvx<0.35) R.bvx=0; }
    const st=tryStomp(R.x-60, GROUND-190, 120, 180);
    if (st===1) { robotStomped(); return; }
    else if (st===-1) playerHit();
    if (--R.stun<=0) { R.phase='enter'; R.t=0; }
  }
  else if (R.phase==='dying') {
    if (R.t%8===0) { fx('explosion', R.x-60+Math.random()*120, R.y-60+Math.random()*120); shake(6); }
    if (R.t>70) { bossDefeated(); return; }
  }
  bossCommonTick();
}

// ── MUNDO 2: BUBEADO LA RANA (duelo naval — te subes al cañón del barco;
//    apunta con el puntero, esquiva sus burbujas y su láser) ──
function startBossFrog() {
  state=ST.BOSS;
  FB={ phase:'enter', t:0, x:W+220, y:210, hp:bossHp(8), maxHp:bossHp(8),
       af:0, laserT:0, laserY:0, flash:0,
       shipX:150, shipY:260, nav:null, fireT:0, bullets:[], bubbles:[] };
  FB.nav={ x:150, y:260, tx:150, ty:260 };
  dragDX=0; dragDY=0;
  RB=null; GB=null;
  obstacles=[]; coinItems=[]; gemItems=[]; powerUps=[]; robotEv=null;
  P.jumps=0; P.vy=0; P.ducking=false;
  AudioMan.stopRun();
  AudioMan.sfx('nave-aparece');
  AudioMan.music('musica-ingame', 1.14);
}
function updateBossFrog() {
  const B=FB; B.t++;
  steerShip(B.nav, 80, W*0.55, 90, GROUND-40);
  B.shipX=B.nav.x; B.shipY=B.nav.y;

  bgOff+=speed*0.08; mtnOff+=speed*0.45; waveOff+=speed;
  for (const cl of clouds) { cl.x-=cl.sp*speed*0.55; if (cl.x+cl.w<-20) cl.x=W+cl.w+Math.random()*200; }

  if (B.phase==='enter') {
    B.x += (W-190-B.x)*0.05;
    if (Math.abs(B.x-(W-190))<4) { B.phase='fight'; B.t=0; }
  }
  else if (B.phase==='fight') {
    B.y = 210 + Math.sin(B.t*0.023)*115;
    if (B.t%9===0) B.af=(B.af+1)%11;
    // burbujas flotantes que persiguen suavemente
    if (B.t%110===0) {
      B.bubbles.push({ x:B.x-70, y:B.y, vx:-2.6, vy:0, t:0 });
      AudioMan.sfx('bruja-dispara',{rate:1.4,vol:0.6});
    }
    B.laserT++;
    const cycle = Math.max(150, 260-lap*30);
    if (B.laserT===cycle-60) AudioMan.sfx('nave-carga');
    if (B.laserT>=cycle) { B.phase='laser'; B.t=0; B.laserY=B.y; AudioMan.sfx('nave-lanza'); }
    if (++B.fireT>=26) { B.fireT=0; B.bullets.push({ x:B.shipX+55, y:B.shipY+6, vx:11 }); AudioMan.sfx('nave-disparo',{vol:0.7}); }
  }
  else if (B.phase==='laser') {
    if (B.t>75) { B.phase='fight'; B.laserT=0; B.t=0; }
    else if (B.t>20) {
      if (Math.abs(B.shipY-B.laserY)<42 && B.shipX<B.x-60 && P.invincible<=0) hitInShip(B.shipX, B.shipY);
    }
    if (++B.fireT>=26) { B.fireT=0; B.bullets.push({ x:B.shipX+55, y:B.shipY+6, vx:11 }); AudioMan.sfx('nave-disparo',{vol:0.7}); }
  }
  else if (B.phase==='dying') {
    if (B.t%9===0) { fx('explosion', B.x-70+Math.random()*160, B.y-60+Math.random()*130); shake(6); }
    if (B.t>80) { bossDefeated(); return; }
  }

  B.bubbles=B.bubbles.filter(bu=>{
    bu.t++;
    bu.vy += ((B.shipY-bu.y)>0?0.06:-0.06);
    bu.vy = Math.max(-2.2, Math.min(2.2, bu.vy));
    bu.x+=bu.vx; bu.y+=bu.vy;
    if (B.phase!=='dying' && P.invincible<=0 &&
        overlaps(bu.x-22,bu.y-22,44,44, B.shipX-46,B.shipY-30,92,60, 4)) {
      hitInShip(B.shipX, B.shipY);
      burst(bu.x,bu.y,'#a8e6ff',10);
      return false;
    }
    return bu.x>-60 && bu.t<600;
  });

  if (P.invincible>0) P.invincible--;
  if (P.shielded>0)   P.shielded--;

  B.bullets = B.bullets.filter(b => {
    b.x+=b.vx;
    if (B.phase!=='dying' &&
        overlaps(b.x-14,b.y-7,28,14, B.x-80,B.y-55,160,120, 0)) {
      B.hp--; B.flash=8;
      burst(b.x,b.y,'#aaffcc',6);
      AudioMan.sfx('coin',{rate:0.6,vol:0.5});
      if (B.hp<=0) {
        B.phase='dying'; B.t=0;
        AudioMan.sfx('powerup-explosion');
        AudioMan.sfx('bruja-desaparece');
      }
      return false;
    }
    return b.x<W+40;
  });
  if (B.flash>0) B.flash--;

  tickEffects(); tickParticles(); tickFloatTexts();
  if (shakeF>0) shakeF--;
  calcScore();
}
function hitInShip(sx, sy) {
  if (P.shielded>0) { P.shielded=0; fx('hit',sx,sy); P.invincible=60; shake(8); return; }
  lives--; shake(12); fx('hit',sx,sy);
  burst(sx,sy,'#ff5533',16);
  if (lives<=0) { killPlayer(); return; }
  P.invincible=90;
}

// ── MUNDO 3: GUNILDA (teletransporte + magia; solo es vulnerable
//    justo después de lanzar su hechizo triple) ──
function startBossGunilda() {
  state=ST.BOSS;
  GB={ phase:'enter', t:0, x:W+160, y:180, hp:bossHp(4), maxHp:bossHp(4),
       af:0, alpha:1, hitFlash:0, spot:0, shots:0, vulnT:0 };
  RB=null; FB=null;
  obstacles=[]; coinItems=[]; gemItems=[]; powerUps=[]; robotEv=null;
  AudioMan.sfx('bruja-aparece');
  AudioMan.music('musica-ingame', 1.14);
}
const GUN_SPOTS=[ {x:W-180,y:170},{x:W-320,y:250},{x:W-140,y:300},{x:W-420,y:160} ];
function updateBossGunilda() {
  const G=GB; G.t++;
  if (G.t%7===0) G.af=(G.af+1)%3;
  if (G.hitFlash>0) G.hitFlash--;
  runnerPhysics();

  if (G.phase==='enter') {
    G.x += (GUN_SPOTS[0].x-G.x)*0.06;
    G.y = 180+Math.sin(G.t*0.05)*14;
    if (Math.abs(G.x-GUN_SPOTS[0].x)<6) { G.phase='taunt'; G.t=0; }
  }
  else if (G.phase==='taunt') {
    G.y += Math.sin(G.t*0.08)*0.8;
    if (G.t>55) { G.phase='cast'; G.t=0; G.shots=0; AudioMan.sfx('bruja-carga'); }
  }
  else if (G.phase==='cast') {
    G.y += Math.sin(G.t*0.08)*0.5;
    if (G.t>40 && G.t%26===0 && G.shots<3) {
      G.shots++;
      AudioMan.sfx('bruja-dispara');
      const dx=P.x-G.x, dy=(P.y-PH*0.5)-G.y;
      const d=Math.hypot(dx,dy)||1, sp2=6.5+lap*0.7;
      obstacles.push({ type:'bola', x:G.x, y:G.y+40, w:34, h:34, sp:sp2,
                       vx:dx/d*sp2, vy:dy/d*sp2, af:0, at:0, homing:40 });
    }
    if (G.shots>=3 && G.t>140) {
      // agotada: baja y es vulnerable un rato
      G.phase='tired'; G.t=0; G.vulnT=150;
      G.targetY=GROUND-165;   // a la altura justa de un salto, sin rozar al jugador parado
      popup(G.x, G.y-70, '¡AHORA! ¡SALTA SOBRE ELLA!', '#FFDC00', 22);
    }
  }
  else if (G.phase==='tired') {
    G.y += (G.targetY-G.y)*0.12;
    G.x += (P.x+30-G.x)*0.06;   // agotada, flota hasta ponerse a tu alcance
    if (--G.vulnT<=0) {
      G.phase='blink'; G.t=0; AudioMan.sfx('bruja-desaparece');
    }
    const st=tryStomp(G.x-50, G.y-40, 100, 105);
    if (st===1) {
      stompBounce();
      G.hp--; G.hitFlash=10;
      burst(G.x, G.y, '#dd66ff', 16);
      popup(G.x, G.y-80, '¡GOLPE!', '#7CFC00', 26);
      if (G.hp<=0) { G.phase='dying'; G.t=0; AudioMan.sfx('powerup-explosion'); return; }
      G.phase='blink'; G.t=0;
      AudioMan.sfx('bruja-desaparece');
    } else if (st===-1) playerHit();
  }
  else if (G.phase==='blink') {
    G.alpha-=0.06;
    if (G.alpha<=0) {
      G.spot=(G.spot+1)%GUN_SPOTS.length;
      const s=GUN_SPOTS[G.spot];
      G.x=s.x; G.y=s.y; G.alpha=0.01; G.phase='appear';
      AudioMan.sfx('bruja-aparece');
    }
  }
  else if (G.phase==='appear') {
    G.alpha=Math.min(1,G.alpha+0.07);
    if (G.alpha>=1) { G.phase='taunt'; G.t=0; }
  }
  else if (G.phase==='dying') {
    G.alpha=Math.max(0,G.alpha-0.012);
    if (G.t%8===0) { fx('explosion', G.x-50+Math.random()*100, G.y-40+Math.random()*90); shake(5); }
    if (G.t>80) { bossDefeated(); return; }
  }
  bossCommonTick();
}

// física del corredor durante jefes en tierra (Robot y Gunilda)
function runnerPhysics() {
  bgOff+=speed*0.08; mtnOff+=speed*0.45; waveOff+=speed;
  for (const cl of clouds) { cl.x-=cl.sp*speed*0.55; if (cl.x+cl.w<-20) cl.x=W+cl.w+Math.random()*200; }
  if (P.invincible>0) P.invincible--;
  if (P.shielded>0)  P.shielded--;
  if (P.boosted>0)  { P.boosted--; if (!P.boosted) speed=Math.max(baseSpeed(),speed-2.5); }
  if (duckT>0 && --duckT===0 && !keys['ArrowDown'] && !keys['KeyS']) P.ducking=false;
  const wasAir=P.y<GROUND-1;
  P.vy+=GRAVITY; P.y+=P.vy;
  if (P.y>=GROUND) {
    if (wasAir && P.vy>13) { burst(P.x, GROUND-6, '#cfe4ff', 8); shake(3); }
    P.y=GROUND; P.vy=0; P.jumps=0;
    if (wasAir) AudioMan.startRun();
  }
  if (P.y>=GROUND-1) {
    P.atimer+=speed*0.034;
    if (P.atimer>=1) { P.atimer=0; P.anim=(P.anim+1)%runFrames(); }
  }
  // bolas mágicas residuales durante el jefe
  updateObstacles();
  checkCollisions();
}
function bossCommonTick() {
  tickEffects(); tickParticles(); tickFloatTexts();
  if (shakeF>0) shakeF--;
  calcScore();
}

function bossDefeated() {
  bossesKilled++;
  misEvent('boss');
  RB=null; FB=null; GB=null;
  coins+=25;
  gems=Math.min(GEMS_FOR_TURBO-1,gems+1);
  if (lives<LIVES) lives++;
  P.y=GROUND; P.vy=0;
  if (world<2) {
    // secuencia: la nave aterriza, el héroe corre y SE MONTA
    startBoarding();
  } else {
    // Gunilda huye en su escoba → duelo aéreo final
    startDuel();
  }
}

// ═══════════════════════════════════════════════════════
//  EMBARQUE — la nave aterriza delante y el héroe se sube
// ═══════════════════════════════════════════════════════
function startBoarding() {
  state=ST.BOARD;
  BD={ t:0, shipX:W+160, shipY:80, phase:'land' };
  AudioMan.stopRun();
  AudioMan.sfx('nave-aparece');
  popup(W/2, 140, '¡Tu nave ha llegado!', '#7FDBFF', 28);
}
function updateBoarding() {
  const b=BD; b.t++;
  bgOff+=2; mtnOff+=3; waveOff+=4;
  for (const cl of clouds) { cl.x-=cl.sp*2; if (cl.x+cl.w<-20) cl.x=W+cl.w; }
  if (b.phase==='land') {
    b.shipX += (P.x+260-b.shipX)*0.06;
    b.shipY += (GROUND-46-b.shipY)*0.06;
    if (Math.abs(b.shipY-(GROUND-46))<3 && Math.abs(b.shipX-(P.x+260))<6) {
      b.phase='run'; b.t=0;
      AudioMan.startRun();
    }
  } else if (b.phase==='run') {
    // el héroe corre hacia la nave
    P.x += 3.4;
    P.atimer+=0.16;
    if (P.atimer>=1){ P.atimer=0; P.anim=(P.anim+1)%runFrames(); }
    if (P.x >= b.shipX-30) {
      b.phase='hop'; b.t=0;
      P.vy=-11;
      AudioMan.stopRun();
    }
  } else if (b.phase==='hop') {
    // saltito para montarse
    P.vy+=GRAVITY*0.9;
    P.y+=P.vy;
    P.x+=2.2;
    if (P.y>=GROUND-40) {
      b.phase='takeoff'; b.t=0;
      burst(b.shipX, GROUND-20, '#7FDBFF', 14);
      AudioMan.sfx('nave-carga');
    }
  } else if (b.phase==='takeoff') {
    b.shipY -= b.t*0.14;
    b.shipX += b.t*0.10;
    if (b.t%5===0) particles.push({ x:b.shipX-40, y:b.shipY+26, vx:-3-Math.random()*2, vy:1+Math.random(),
                                    life:0.9, r:3+Math.random()*4, color:'#9adcff' });
    if (b.shipY<-140) { startFly(); return; }
  }
  tickEffects(); tickParticles(); tickFloatTexts();
}

// ═══════════════════════════════════════════════════════
//  COMBATE ESPACIAL — shoot 'em up entre mundos
//  (oleadas de enemigos, power-ups de nave y jefe aéreo)
// ═══════════════════════════════════════════════════════
const FLY_WAVES=12;
const FLY_NAMES=['PATRULLA','¡FORMACIÓN EN V!','CAMPO DE MINAS','CAZAS ENEMIGOS',
                 '¡ASTEROIDES!','DOBLE FORMACIÓN','ESCUADRÓN DE CAZAS','¡ENJAMBRE!',
                 'ROCAS Y MINAS','EMBOSCADA','CAMPO DENSO','¡ESCUADRÓN ÉLITE!'];
function startFly(startWave=0) {
  state=ST.FLY;
  F={ t:0, x:150, y:H/2, tx:150, ty:H/2, phase:'waves', theme:Math.min(1,world),
      bullets:[], foes:[], shots:[], pups:[], coins:[],
      waveIdx:startWave, waveT:90, fireT:0, pupT:560,
      weapon:'single', wTime:0, boss:null, kills:0,
      squads:{}, sqNext:1, warnT:0 };
  initStars();
  dragDX=0; dragDY=0;
  AudioMan.sfx('powerup-turbo');
  if (!AudioMan.musicSrc) AudioMan.music('musica-ingame');
  if (startWave>0) {
    popup(W/2, 130, startWave>=FLY_WAVES?'¡OTRA VEZ EL JEFE!':'¡SEGUIMOS! OLEADA '+(startWave+1), '#7FDBFF', 28);
  } else {
    popup(W/2, 130, '¡ZONA DE COMBATE!', '#7FDBFF', 30);
    popup(W/2, 172, 'Arrastra el dedo: la nave te sigue y dispara sola', '#fff', 18);
  }
}
function flyFoe(o){ F.foes.push(Object.assign({ t:0, af:0, hitF:0, ph:0 }, o)); }
function flyAster(x, y, big) {
  const r=big?44:24, verts=[];
  for (let k=0;k<9;k++) verts.push(0.75+Math.random()*0.4);
  flyFoe({ kind:'aster', x, y, hp:big?3:1, r, big, verts,
           rot:Math.random()*6, vr:(Math.random()-0.5)*0.05,
           vx:-(2.0+Math.random()*1.2),
           vy:big ? (Math.random()-0.5)*0.8 : (Math.random()<0.5?-1:1)*(0.9+Math.random()*0.9) });
}
function flySquadV(x0, y0) {
  // formación en V estilo 1942: destrúyela entera antes de que escape → bonus
  const id=F.sqNext++;
  F.squads[id]={ left:5, broken:false };
  for (let k=0;k<5;k++) {
    flyFoe({ kind:'drone', x:x0+Math.abs(k-2)*85, y:y0+(k-2)*62, hp:1, ph:k*0.7,
             sq:id, spd:3.4+F.waveIdx*0.08+lap*0.35 });
  }
}
function flyFighter(x, y, sx, shT, hp) {
  flyFoe({ kind:'fighter', x, y, hp:hp||3, sx, shT });
}
function flyCoinArc(x0, n) {
  const y1=110+Math.random()*(H-260);
  for (let k=0;k<n;k++) F.coins.push({ x:x0+k*48, y:y1+Math.sin(k*0.8)*40, af:k%7, at:0 });
}
function flySpawnWave(i) {
  const spd=3.2+i*0.10+lap*0.4;
  const shT0=Math.max(70, 130-i*4-lap*10);
  if (i===0) {
    for (let k=0;k<4;k++) flyFoe({ kind:'drone', x:W+60+k*110, y:150+k*70, hp:1, ph:k*1.3, spd });
    flyCoinArc(W+560, 6);
  } else if (i===1) {
    flySquadV(W+80, H/2);
  } else if (i===2) {
    for (let k=0;k<6;k++) flyFoe({ kind:'mine', x:W+60+k*125, y:80+Math.random()*(H-190), hp:1, rot:Math.random()*6, vr:(Math.random()-0.5)*0.09 });
    flyCoinArc(W+120, 8);
  } else if (i===3) {
    flyFighter(W+80,  150,   620, shT0);
    flyFighter(W+220, H-160, 700, shT0+55);
    for (let k=0;k<3;k++) flyFoe({ kind:'drone', x:W+420+k*115, y:H/2-80+k*80, hp:1, ph:k*2, spd });
  } else if (i===4) {
    for (let k=0;k<4;k++) flyAster(W+80+k*190, 100+Math.random()*(H-220), true);
    F.pups.push({ x:W+40, y:H/2, type:'shield', af:0, at:0 });
  } else if (i===5) {
    flySquadV(W+80,  H/2-95);
    flySquadV(W+420, H/2+95);
  } else if (i===6) {
    flyFighter(W+60,  120,   660, shT0);
    flyFighter(W+200, H/2,   560, shT0+45);
    flyFighter(W+340, H-130, 720, shT0+90);
    for (let k=0;k<3;k++) flyFoe({ kind:'mine', x:W+520+k*140, y:100+Math.random()*(H-220), hp:1, rot:0, vr:0.05 });
  } else if (i===7) {
    for (let k=0;k<8;k++) flyFoe({ kind:'drone', x:W+60+k*95, y:110+(k%4)*95, hp:1, ph:k*1.1, spd:spd+0.8 });
    flyCoinArc(W+840, 7);
  } else if (i===8) {
    for (let k=0;k<3;k++) flyAster(W+100+k*240, 110+Math.random()*(H-240), true);
    for (let k=0;k<4;k++) flyFoe({ kind:'mine', x:W+180+k*170, y:80+Math.random()*(H-190), hp:1, rot:0, vr:-0.06 });
    F.pups.push({ x:W+40, y:H/2, type:'shield', af:0, at:0 });
  } else if (i===9) {
    flySquadV(W+80, H/2);
    flyFighter(W+520, 140,   680, shT0);
    flyFighter(W+520, H-140, 740, shT0+60);
  } else if (i===10) {
    for (let k=0;k<5;k++) flyAster(W+80+k*170, 90+Math.random()*(H-200), k%2===0);
    for (let k=0;k<4;k++) flyFoe({ kind:'drone', x:W+220+k*160, y:130+k*85, hp:1, ph:k*1.6, spd });
  } else {
    for (let k=0;k<6;k++) flyFoe({ kind:'drone', x:W+60+k*105, y:120+k*62, hp:2, ph:k*1.4, spd:spd+0.6 });
    flyFighter(W+520, H/2-110, 640, shT0, 5);
    flyFighter(W+640, H/2+110, 700, shT0+50, 5);
    flyCoinArc(W+760, 8);
  }
  popup(W/2, 110, 'OLEADA '+(i+1)+'/'+FLY_WAVES+' — '+FLY_NAMES[i], '#7FDBFF', 24);
}
function flyBossWarning() {
  F.phase='warning'; F.warnT=150; F.shots=[];
  AudioMan.sfx('nave-carga');
  shake(6);
}
function flySpawnBoss() {
  const f=F;
  f.phase='boss';
  // vida alta = pelea de 1-2 min como en los shmup clásicos (antes se fundían en segundos)
  const hp=(f.theme===0?85:95)+lap*12;
  f.boss={ x:W+260, y:H/2, hp, maxHp:hp, t:0, af:0, phase:'enter', pt:0, flash:0,
           homeX:W-190, aimY:H/2, lockY:H/2, ys:[], enraged:false };
  AudioMan.sfx(f.theme===0?'robot-aparece':'bruja-aparece');
  popup(W/2, 150, f.theme===0?'¡¡NAVE NODRIZA!!':'¡¡LA NAVE DE GUNILDA!!', '#FF4136', 38);
  shake(12);
}
function flyDamageShip() {
  if (P.shielded>0) {
    P.shielded=0; P.invincible=60;
    fx('hit', F.x, F.y); burst(F.x, F.y, '#88ddff', 14); shake(8);
    return false;
  }
  lives--; combo=0; comboT=0;
  shake(12); fx('hit', F.x, F.y); burst(F.x, F.y, '#ff5533', 16);
  if (lives<=0) { killPlayer(); return true; }
  P.invincible=90;
  return false;
}
function flyPickPup(type) {
  AudioMan.sfx('powerup-escudo');
  if (type==='shield') { P.shielded=900; popup(F.x, F.y-55, '¡ESCUDO!', '#44aaff', 26); return; }
  F.weapon=type; F.wTime=760;
  popup(F.x, F.y-55, type==='double'?'¡DISPARO DOBLE!':type==='spread'?'¡ABANICO!':'¡METRALLETA!', '#FFDC00', 26);
}
function flyKillFoe(e) {
  fx('explosion', e.x, e.y); shake(e.kind==='aster'&&e.big?7:4);
  AudioMan.sfx('powerup-explosion',{vol:0.45, rate:e.kind==='aster'&&e.big?0.9:1.25});
  F.kills++; bonusPts+=20;
  popup(e.x, e.y-30, '+20', '#FFDC00', 20);
  const n=1+(Math.random()*2|0);
  for (let i=0;i<n;i++) F.coins.push({ x:e.x+i*32, y:e.y+(Math.random()-0.5)*44, af:i%7, at:0 });
  if (e.kind==='aster' && e.big) {
    // el asteroide grande se parte en dos trozos (estilo Asteroids)
    flyAster(e.x, e.y-14, false); flyAster(e.x, e.y+14, false);
    const a=F.foes[F.foes.length-2], b2=F.foes[F.foes.length-1];
    a.vy=-Math.abs(a.vy)-0.6; b2.vy=Math.abs(b2.vy)+0.6;
  }
  if (e.kind==='fighter' && Math.random()<0.35) {
    F.pups.push({ x:e.x, y:e.y, type:['double','spread','rapid','shield'][Math.random()*4|0], af:0, at:0 });
  }
  if (e.sq) {
    const q=F.squads[e.sq];
    if (q) {
      q.left--;
      if (q.left<=0 && !q.broken) {
        bonusPts+=150;
        popup(e.x, e.y-64, '¡FORMACIÓN COMPLETA! +150', '#7CFC00', 24);
        AudioMan.sfx('gema');
        for (let i=0;i<4;i++) F.coins.push({ x:e.x+i*36, y:e.y+(Math.random()-0.5)*60, af:i%7, at:0 });
      }
    }
  }
}
function updateFly() {
  const f=F; f.t++;
  steerShip(f, 70, W*0.60, 70, H-70);

  const starSpd = f.phase==='warning' ? 5 : 2.2;
  for (const s of stars) { s.x-=s.sp*starSpd; if (s.x<-4){ s.x=W+4; s.y=Math.random()*H; } }

  // ── cuenta atrás de alerta: el jefe se acerca ──
  if (f.phase==='warning') {
    if (f.warnT%38===0) AudioMan.sfx('soldado-aviso',{vol:0.5});
    if (--f.warnT<=0) flySpawnBoss();
  }

  // ── disparo automático de la nave ──
  if (f.wTime>0 && --f.wTime===0) { f.weapon='single'; popup(f.x, f.y-50, 'arma normal', '#aabbcc', 17); }
  const cad = f.weapon==='rapid'?9 : f.weapon==='double'?19 : f.weapon==='spread'?23 : 21;
  if (++f.fireT>=cad) {
    f.fireT=0;
    const bx=f.x+58, by=f.y+4;
    if (f.weapon==='double') f.bullets.push({x:bx,y:by-13,vx:12,vy:0},{x:bx,y:by+11,vx:12,vy:0});
    else if (f.weapon==='spread') f.bullets.push({x:bx,y:by,vx:12,vy:0},{x:bx,y:by,vx:11,vy:-3.4},{x:bx,y:by,vx:11,vy:3.4});
    else f.bullets.push({x:bx,y:by,vx:12,vy:0});
    AudioMan.sfx('nave-disparo',{vol:0.4, rate:f.weapon==='rapid'?1.3:1});
  }
  for (const b of f.bullets) { b.x+=b.vx; b.y+=b.vy; }

  // ── oleadas: la siguiente entra al despejar la pantalla ──
  if (f.phase==='waves' && f.foes.length===0) {
    if (--f.waveT<=0) {
      if (f.waveIdx>=FLY_WAVES) flyBossWarning();
      else { flySpawnWave(f.waveIdx); f.waveIdx++; f.waveT=55; }
    }
  }

  // ── power-ups periódicos ──
  if (--f.pupT<=0) {
    f.pupT=520+(Math.random()*260|0);
    const r=Math.random();
    f.pups.push({ x:W+40, y:90+Math.random()*(H-180),
      type: r<0.3?'double': r<0.58?'spread': r<0.82?'rapid':'shield', af:0, at:0 });
  }
  f.pups=f.pups.filter(pu=>{
    pu.x-=3; pu.at++;
    if (pu.at%5===0) pu.af=(pu.af+1)%14;
    if (Math.hypot(pu.x-f.x, pu.y-f.y)<48) { flyPickPup(pu.type); return false; }
    return pu.x>-50;
  });

  // ── enemigos ──
  for (const e of f.foes) {
    e.t++;
    if (e.hitF>0) e.hitF--;
    if (e.kind==='drone') {
      e.x-=(e.spd||3.4); e.y+=Math.sin((e.t+e.ph*12)*0.055)*2.4;
      if (e.t%6===0) e.af=(e.af+1)%8;
    } else if (e.kind==='mine') {
      e.x-=2.3; e.rot+=e.vr;
      if (e.t%8===0) e.af=(e.af+1)%4;
    } else if (e.kind==='aster') {
      e.x+=e.vx; e.y+=e.vy; e.rot+=e.vr;
      if (e.y<50||e.y>H-50) e.vy*=-1;
    } else if (e.kind==='fighter') {
      if (e.x>e.sx) e.x-=4; else e.y+=Math.sin(e.t*0.03)*1.3;
      if (e.x<=e.sx && --e.shT<=0) {
        e.shT=Math.max(75, 130-f.waveIdx*3-lap*12);
        const dx=f.x-e.x, dy=f.y-e.y, dd=Math.hypot(dx,dy)||1, sp2=5.2+f.waveIdx*0.06+lap*0.5;
        f.shots.push({ x:e.x-40, y:e.y, vx:dx/dd*sp2, vy:dy/dd*sp2, spr:f.theme===0?'missile':'bola', af:0, at:0, hom:0 });
        AudioMan.sfx(f.theme===0?'nave-lanza':'bruja-dispara',{vol:0.55});
      }
    }
    // choque contra la nave
    const crad = e.kind==='aster' ? e.r+26 : 58;
    if (P.invincible<=0 && e.hp>0 && Math.hypot(f.x-e.x, f.y-e.y)<crad) {
      e.hp=0; fx('explosion', e.x, e.y);
      if (e.sq && f.squads[e.sq]) { f.squads[e.sq].left--; f.squads[e.sq].broken=true; }
      if (flyDamageShip()) return;
    }
  }

  // ── jefe aéreo ──
  if (f.boss) { if (updateFlyBoss()) return; }

  // ── balas propias vs enemigos/jefe ──
  for (const b of f.bullets) {
    if (b.dead || b.x>W+40) continue;
    for (const e of f.foes) {
      if (e.hp<=0) continue;
      const rad = e.kind==='fighter'?48 : e.kind==='mine'?30 : e.kind==='aster'?e.r : 36;
      if (Math.hypot(b.x-e.x, b.y-e.y)<rad) {
        b.dead=true; e.hp--; e.hitF=5;
        burst(b.x, b.y, '#7FDBFF', 5);
        if (e.hp<=0) flyKillFoe(e);
        break;
      }
    }
    if (!b.dead && f.boss && f.boss.phase!=='dying' && f.boss.phase!=='enter' && Math.hypot(b.x-f.boss.x, b.y-f.boss.y)<(f.theme===0?90:82)) {
      b.dead=true; f.boss.hp--; f.boss.flash=6;
      burst(b.x, b.y, '#ffee55', 6);
      AudioMan.sfx('coin',{rate:0.6, vol:0.4});
      if (f.boss.hp<=0) { f.boss.phase='dying'; f.boss.t=0; f.shots=[]; AudioMan.sfx('powerup-explosion'); }
    }
  }
  f.bullets=f.bullets.filter(b=>!b.dead && b.x<W+40 && b.y>-30 && b.y<H+30);
  f.foes=f.foes.filter(e=>{
    if (e.hp<=0) return false;
    if (e.x<-100) {
      if (e.sq && f.squads[e.sq]) f.squads[e.sq].broken=true;   // la formación escapó
      return false;
    }
    return true;
  });

  // ── disparos enemigos ──
  let shipKilled=false;
  f.shots=f.shots.filter(s=>{
    if (s.hom>0) {
      s.hom--;
      const dx=f.x-s.x, dy=f.y-s.y, dd=Math.hypot(dx,dy)||1, sp2=Math.hypot(s.vx,s.vy);
      s.vx+=(dx/dd*sp2-s.vx)*0.045; s.vy+=(dy/dd*sp2-s.vy)*0.045;
    }
    s.x+=s.vx; s.y+=s.vy; s.at++;
    if (s.at%6===0) s.af=(s.af+1)%(s.spr==='burb'?14:3);
    if (s.spr==='burb' && s.at>300) { burst(s.x,s.y,'#9adcff',6); return false; }
    if (!shipKilled && P.invincible<=0 && Math.hypot(s.x-f.x, s.y-f.y)<44) {
      shipKilled=flyDamageShip();
      return false;
    }
    return s.x>-60 && s.x<W+80 && s.y>-60 && s.y<H+60;
  });
  if (shipKilled) return;

  // ── monedas ──
  f.coins=f.coins.filter(c=>{
    c.x-=3.4; c.at++;
    if (c.at%5===0) c.af=(c.af+1)%7;
    if (Math.hypot(c.x-f.x, c.y-f.y)<50) {
      coins++; bonusPts+=5; misEvent('coin');
      burst(c.x,c.y,'#FFD700',6);
      AudioMan.sfx('coin',{vol:0.7});
      return false;
    }
    return c.x>-40;
  });

  if (P.invincible>0) P.invincible--;
  if (P.shielded>0)   P.shielded--;
  tickEffects(); tickParticles(); tickFloatTexts();
  if (shakeF>0) shakeF--;
  calcScore();
}
function updateFlyBoss() {
  const f=F, b=f.boss;
  b.t++; b.pt++;
  if (b.flash>0) b.flash--;
  if (b.t%7===0) b.af=(b.af+1)%8;

  // furia al 30% de vida: patrones más rápidos
  if (!b.enraged && b.phase!=='dying' && b.hp<=b.maxHp*0.3) {
    b.enraged=true;
    popup(b.x, b.y-170, '¡¡FURIA!!', '#FF4136', 32);
    AudioMan.sfx('robot-carga'); shake(8);
  }
  const rage = b.enraged?1.3:1;

  if (b.phase==='dying') {
    b.x+=0.8; b.y+=Math.sin(b.t*0.25)*2.5;
    if (b.t%6===0) { fx('explosion', b.x-90+Math.random()*180, b.y-90+Math.random()*180); shake(6); }
    if (b.t%9===0) F.coins.push({ x:b.x-70+Math.random()*140, y:b.y-70+Math.random()*140, af:0, at:0 });
    if (b.t===60) popup(W/2, H/2-40, '¡¡DERRIBADO!!', '#7CFC00', 42);
    if (b.t>130) {
      bossesKilled++; misEvent('boss');
      coins+=25; gems=Math.min(GEMS_FOR_TURBO-1, gems+1);
      if (lives<LIVES) lives++;
      startWorld(world+1, {fromShip:true});
      return true;
    }
    return false;
  }

  if (b.phase==='enter') {
    b.x+=(b.homeX-b.x)*0.045;
    b.y=H/2+Math.sin(b.t*0.03)*40;
    if (Math.abs(b.x-b.homeX)<8) { b.phase= f.theme===0?'lock':'spiral'; b.pt=0; }
  }
  else if (f.theme===0) {
    // ═ ROBOT NODRIZA ═ apunta con mira láser → lluvia avisada → embestida que cruza
    if (b.phase==='lock') {
      // te persigue despacio con la mira puesta: los disparos salen RECTOS a su altura
      b.aimY+=(f.y-b.aimY)*0.055;
      b.y+=(b.aimY-b.y)*0.09;
      if ((b.pt===55||b.pt===105||b.pt===155) && b.pt<170) {
        const sp2=(6.6+lap*0.5)*rage;
        f.shots.push({ x:b.x-85, y:b.y-16, vx:-sp2, vy:0, spr:'laser', af:0, at:0, hom:0 });
        f.shots.push({ x:b.x-85, y:b.y+20, vx:-sp2, vy:0, spr:'laser', af:0, at:0, hom:0 });
        AudioMan.sfx('robot-rayo');
      }
      if (b.pt>175) {
        b.phase='rainWarn'; b.pt=0;
        b.ys=[];
        for (let k=0;k<(b.enraged?6:5);k++) b.ys.push(90+Math.random()*(H-190));
        AudioMan.sfx('robot-carga');
      }
    }
    else if (b.phase==='rainWarn') {
      // marcas de aviso en el borde derecho: ahí entrarán los misiles
      if (b.pt>48) { b.phase='rain'; b.pt=0; }
    }
    else if (b.phase==='rain') {
      const idx=Math.floor(b.pt/12);
      if (b.pt%12===1 && idx<b.ys.length) {
        f.shots.push({ x:W+30, y:b.ys[idx], vx:-(7.6+lap*0.5)*rage, vy:0, spr:'missile', af:0, at:0, hom:0 });
        AudioMan.sfx('nave-lanza',{vol:0.6});
      }
      if (b.pt>12*b.ys.length+34) { b.phase='dashPrep'; b.pt=0; b.lockY=f.y; AudioMan.sfx('soldado-aviso'); }
    }
    else if (b.phase==='dashPrep') {
      // fija tu altura ACTUAL y avisa: ¡quítate de esa línea!
      b.y+=(b.lockY-b.y)*0.16;
      if (b.pt>52) { b.phase='dash'; b.pt=0; AudioMan.sfx('soldado-embiste'); }
    }
    else if (b.phase==='dash') {
      b.x-=(10.5+lap)*rage;
      if (gframe%2===0) particles.push({ x:b.x+90, y:b.y+(Math.random()-0.5)*60, vx:3, vy:(Math.random()-0.5)*2, life:0.5, r:3+Math.random()*4, color:'#ffaa44' });
      if (b.x<-160) { b.x=W+180; b.phase='dashBack'; b.pt=0; }
    }
    else if (b.phase==='dashBack') {
      b.x+=(b.homeX-b.x)*0.08;
      if (Math.abs(b.x-b.homeX)<6) { b.x=b.homeX; b.phase='lock'; b.pt=0; }
    }
  }
  else {
    // ═ NAVE DE GUNILDA ═ anillos de magia → refuerzos → andanada → láser barredor
    if (b.phase!=='laser' && b.phase!=='laserPrep') {
      const ty=H/2+Math.sin(b.t*0.025)*120;
      b.y+=(ty-b.y)*0.05;
    }
    if (b.phase==='spiral') {
      if (b.pt%34===16 && b.pt<130) {
        for (let k=0;k<8;k++) {
          const a=k/8*Math.PI*2 + b.pt*0.05;
          f.shots.push({ x:b.x, y:b.y, vx:Math.cos(a)*2.7*rage, vy:Math.sin(a)*2.7*rage, spr:'bola', af:0, at:0, hom:0 });
        }
        AudioMan.sfx('bruja-dispara',{rate:1.2, vol:0.7});
      }
      if (b.pt>170) { b.phase='minions'; b.pt=0; }
    }
    else if (b.phase==='minions') {
      if (b.pt===18 && f.foes.length<5) {
        flyFoe({ kind:'drone', x:W+60, y:b.y-120, hp:1, ph:0, spd:3.8 });
        flyFoe({ kind:'drone', x:W+60, y:b.y+120, hp:1, ph:2, spd:3.8 });
        popup(b.x, b.y-150, '¡REFUERZOS!', '#ffaaff', 22);
        AudioMan.sfx('robot-aparece',{vol:0.6});
      }
      if (b.pt>55) { b.phase='volley'; b.pt=0; }
    }
    else if (b.phase==='volley') {
      if (b.pt%40===24 && b.pt<140) {
        const dx=f.x-b.x, dy=f.y-b.y, dd=Math.hypot(dx,dy)||1, sp2=(6.2+lap*0.5)*rage;
        for (let k=-1;k<=1;k++) {
          f.shots.push({ x:b.x-60, y:b.y, vx:dx/dd*sp2, vy:dy/dd*sp2+k*1.7, spr:'bola', af:0, at:0, hom:0 });
        }
        AudioMan.sfx('bruja-dispara',{vol:0.65});
      }
      if (b.pt>165) { b.phase='laserPrep'; b.pt=0; b.lockY=f.y; AudioMan.sfx('bruja-carga'); }
    }
    else if (b.phase==='laserPrep') {
      // se coloca a la altura marcada; la línea de mira parpadea
      b.y+=(b.lockY-b.y)*0.13;
      if (b.pt>55) { b.phase='laser'; b.pt=0; b.sweep=(f.y>b.y?1:-1)*0.95; AudioMan.sfx('robot-rayo',{rate:0.8}); }
    }
    else if (b.phase==='laser') {
      // el rayo BARRE lentamente: huye en vertical o ponte detrás
      b.y+=b.sweep*rage;
      b.y=Math.max(90,Math.min(H-90,b.y));
      if (b.pt<85 && P.invincible<=0 && Math.abs(f.y-b.y)<40 && f.x<b.x-50) {
        if (flyDamageShip()) return true;
      }
      if (b.pt>95) { b.phase='spiral'; b.pt=0; }
    }
  }

  // contacto con el cuerpo del jefe
  if (P.invincible<=0 && Math.hypot(f.x-b.x, f.y-b.y)<(f.theme===0?100:92)) {
    if (flyDamageShip()) return true;
  }
  return false;
}

// ═══════════════════════════════════════════════════════
//  DUELO FINAL — nave vs Gunilda en escoba, cielo de Marte
// ═══════════════════════════════════════════════════════
function startDuel() {
  state=ST.DUEL;
  D={ t:0, x:170, y:H/2, tx:170, ty:H/2, bullets:[], bolas:[],
      gx:W-170, gy:H/2, gvy:1.6, hp:bossHp(12), maxHp:bossHp(12),
      flash:0, fireT:0, castT:0, phase:'fight' };
  initStars();
  dragDX=0; dragDY=0;
  AudioMan.stopRun();
  AudioMan.sfx('bruja-aparece');
  AudioMan.music('musica-ingame', 1.14);
  popup(W/2, 130, '¡GUNILDA HUYE! ¡DERRÍBALA!', '#FF4136', 30);
}
function updateDuel() {
  const d=D; d.t++;
  steerShip(d, 70, W*0.55, 70, H-70);

  for (const s of stars) { s.x-=s.sp*1.6; if (s.x<-4){ s.x=W+4; s.y=Math.random()*H; } }

  if (d.phase==='fight') {
    // Gunilda serpentea, a veces se lanza en picado hacia tu columna
    d.gy += d.gvy;
    if (d.gy<90||d.gy>H-90) d.gvy*=-1;
    if (d.t%160===120) d.gvy = (d.y>d.gy?1:-1)*(2.4+lap*0.5);
    if (d.t%160===0)   d.gvy = d.gvy>0?1.6:-1.6;

    if (++d.fireT>=24) { d.fireT=0; d.bullets.push({ x:d.x+55, y:d.y+4, vx:11.5 }); AudioMan.sfx('nave-disparo',{vol:0.65}); }
    if (++d.castT>=Math.max(70,110-lap*15)) {
      d.castT=0;
      AudioMan.sfx('bruja-dispara');
      const dx=(d.x-d.gx), dy=(d.y-d.gy), dd=Math.hypot(dx,dy)||1;
      d.bolas.push({ x:d.gx-40, y:d.gy, vx:dx/dd*6.2, vy:dy/dd*6.2, af:0, at:0 });
    }
  }
  else if (d.phase==='dying') {
    d.gy += 2.4; d.gx += Math.sin(d.t*0.3)*3;
    if (d.t%7===0) { fx('explosion', d.gx-40+Math.random()*80, d.gy-30+Math.random()*60); shake(5); }
    if (d.t>110) { startVictory(); return; }
  }

  d.bullets=d.bullets.filter(b=>{
    b.x+=b.vx;
    if (d.phase==='fight' && overlaps(b.x-14,b.y-7,28,14, d.gx-55,d.gy-55,110,110, 0)) {
      d.hp--; d.flash=8;
      burst(b.x,b.y,'#dd66ff',6);
      AudioMan.sfx('coin',{rate:0.6,vol:0.5});
      if (d.hp<=0) { d.phase='dying'; d.t=0; AudioMan.sfx('powerup-explosion'); AudioMan.sfx('bruja-desaparece'); }
      return false;
    }
    return b.x<W+40;
  });
  d.bolas=d.bolas.filter(bo=>{
    bo.x+=bo.vx; bo.y+=bo.vy; bo.at++;
    if (bo.at%4===0) bo.af=(bo.af+1)%3;
    if (P.invincible<=0 && Math.hypot(bo.x-d.x,bo.y-d.y)<40) {
      if (P.shielded>0){ P.shielded=0; P.invincible=45; fx('hit',d.x,d.y); shake(8); }
      else {
        lives--; shake(12); fx('hit',d.x,d.y); burst(d.x,d.y,'#ff5533',14);
        if (lives<=0){ killPlayer(); return false; }
        P.invincible=80;
      }
      return false;
    }
    return bo.x>-60 && bo.y>-60 && bo.y<H+60;
  });
  if (d.flash>0) d.flash--;
  if (P.invincible>0) P.invincible--;
  if (P.shielded>0)   P.shielded--;

  tickEffects(); tickParticles(); tickFloatTexts();
  if (shakeF>0) shakeF--;
  calcScore();
}
function startVictory() {
  state=ST.VICTORY; victF=0;
  bonusPts+=1000;
  calcScore();
  if (score>hiScore) { hiScore=score; localStorage.setItem('mk_hi',hiScore); }
  brunoJustUnlocked = !brunoOwned;
  if (!brunoOwned) { brunoOwned=true; }
  bank += coins - banked; banked=coins; saveMeta();
  AudioMan.stopMusic();
  AudioMan.sfx('gema');
  AudioMan.sfx('powerup-turbo');
}

// ═══════════════════════════════════════════════════════
//  UPDATE (runner)
// ═══════════════════════════════════════════════════════
function update() {
  if (state===ST.TITLE || state===ST.CHAR_SELECT) {
    for (const cl of clouds) { cl.x-=cl.sp*3.2; if (cl.x+cl.w<-20) cl.x=W+cl.w+Math.random()*100; }
    return;
  }
  if (state===ST.STORY)   { storyF++; if (storyF>420) advanceStory(); return; }
  if (state===ST.DEAD) {
    deadF++;
    if (shakeF>0) shakeF--;
    tickEffects(); tickParticles();
    for (const cl of clouds) { cl.x-=cl.sp*speed*0.5; if (cl.x+cl.w<-20) cl.x=W+cl.w+Math.random()*200; }
    return;
  }
  if (state===ST.BOSS) {
    if (RB) updateBossRobot();
    else if (FB) updateBossFrog();
    else if (GB) updateBossGunilda();
    return;
  }
  if (state===ST.BOARD)   { updateBoarding(); return; }
  if (state===ST.FLY)     { updateFly(); return; }
  if (state===ST.DUEL)    { updateDuel(); return; }
  if (state===ST.VICTORY) { victF++; tickParticles(); tickFloatTexts();
    if (victF%12===0) burst(Math.random()*W, 80+Math.random()*250, ['#FFD700','#FF4136','#7FDBFF','#7CFC00'][victF/12%4|0], 8);
    return; }

  if (state===ST.INTRO) {
    introF++;
    bgOff+=1.2; mtnOff+=2; waveOff+=3;
    for (const cl of clouds) { cl.x-=cl.sp*2; if (cl.x+cl.w<-20) cl.x=W+cl.w+Math.random()*100; }
    if (introShip) {
      // desembarco: la nave desciende, el héroe salta de ella
      if (introF<55) {
        P.shipX = W*0.42 - (introF*1.2);
        P.shipY = -80 + introF*((GROUND-120+80)/55);
      }
      if (introF===55) { AudioMan.sfx('nave-carga'); }
      if (introF>=55 && introF<95) {
        const t=(introF-55)/40;
        P.x = (P.shipX||W*0.35) + (PX-(P.shipX||W*0.35))*t;
        P.y = (GROUND-110) + (GROUND-(GROUND-110))*t*t;
      }
      if (introF===95) { burst(P.x,GROUND-10,'#9adcff',12); shake(4); }
      if (introF>=95) { P.x=PX; P.y=GROUND; beginRun(); }
    } else {
      // arranque mundo 1: sale disparado de la cápsula del laboratorio
      if (introF===45) { AudioMan.sfx('cannon'); shake(10); fx('explosion', 105, GROUND-105); }
      if (introF>=45 && introF<90) {
        const t=(introF-45)/45;
        P.x = 70+(PX-70)*t;
        P.y = GROUND-40 - Math.sin(t*Math.PI)*190 + 40*t;
      }
      if (introF>=90) { P.x=PX; P.y=GROUND; beginRun(); }
    }
    tickEffects(); tickParticles();
    if (shakeF>0) shakeF--;
    return;
  }

  if (state!==ST.PLAYING) return;

  // ── PLAYING ──────────────────────────────────────────
  dist+=speed; worldDist+=speed;
  speed=Math.min(13, speed+0.0018);
  calcScore();
  if (comboT>0 && --comboT===0) combo=0;
  tickFloatTexts();
  tickDelayedObs();
  if (worldBanner>0) worldBanner--;

  misEvent('m', speed/80);
  if (fever>0) {
    fever--;
    if (gframe%2===0) particles.push({
      x:P.x-24+Math.random()*14, y:P.y-Math.random()*PH,
      vx:-2-Math.random()*2, vy:(Math.random()-0.5)*1.6,
      life:0.8, r:3+Math.random()*4, color:`hsl(${(gframe*12)%360},95%,60%)`
    });
  }
  if (Math.floor(dist/80)>=nextMile) {
    const bono=25*(nextMile/250);
    bonusPts+=bono;
    popup(W/2, 120, '🏁 ¡'+nextMile.toLocaleString()+' m!  +'+bono, '#7FDBFF', 30);
    AudioMan.sfx('gema');
    nextMile+=250;
  }
  if (!recordBeaten && hiScore>0 && score>hiScore) {
    recordBeaten=true;
    popup(W/2, 165, '🏆 ¡NUEVO RÉCORD!', '#FFD700', 36);
    burst(P.x, P.y-PH, '#FFD700', 22);
    AudioMan.sfx('gema');
    shake(5);
  }

  const wl=WORLDS[world].len;
  // aviso de jefe cerca del final del mundo
  if (!bossWarned && worldDist>=wl-700) {
    bossWarned=true;
    popup(W/2, 150, '⚠ ¡'+(world===0?'ROBOT GUARDIÁN':world===1?'BUBEADO':'GUNILDA')+' A LA VISTA!', '#FF4136', 30);
    AudioMan.sfx('soldado-aviso');
  }
  if (worldDist>=wl && !robotEv) {
    if (world===0) startBossRobot();
    else if (world===1) startBossFrog();
    else startBossGunilda();
    return;
  }

  bgOff+=speed*0.08; mtnOff+=speed*0.45; waveOff+=speed;
  if (world===2) for (const s of stars) { s.x-=s.sp*0.5; if (s.x<-4){ s.x=W+4; s.y=Math.random()*(GROUND-60); } }

  if (P.invincible>0) P.invincible--;
  if (P.shielded>0)  P.shielded--;
  if (P.cat>0)       P.cat--;
  if (P.boosted>0)  { P.boosted--; if (!P.boosted) speed=Math.max(baseSpeed(),speed-2.5); }
  if (duckT>0 && --duckT===0 && !keys['ArrowDown'] && !keys['KeyS']) P.ducking=false;

  const wasAir = P.y<GROUND-1;
  P.vy+=GRAVITY;
  P.y+=P.vy;
  if (P.y>=GROUND) {
    if (wasAir && P.vy>13) { burst(P.x, GROUND-6, '#cfe4ff', 8); shake(3); }
    P.y=GROUND; P.vy=0; P.jumps=0;
    if (wasAir) AudioMan.startRun();
  }
  if (P.y>=GROUND-1) {
    P.atimer+=speed*0.034;
    if (P.atimer>=1) { P.atimer=0; P.anim=(P.anim+1)%runFrames(); }
  }

  for (const cl of clouds) { cl.x-=cl.sp*speed*0.55; if (cl.x+cl.w<-20) cl.x=W+cl.w+Math.random()*200; }
  if (cameo) { cameo.x-=speed*1.4; cameo.at++; if (cameo.x<-200) cameo=null; }

  if (!robotEv && worldDist<wl-500) {
    if (--spawnT<=0)   { spawnObstacle(); spawnT=Math.max(48,150-Math.floor(hardness()*90)); }
    if (--coinT<=0)    { spawnCoins();    coinT=Math.max(62,140-Math.floor(dist/3000)); }
    if (--gemT<=0)     { spawnGem();      gemT=420+(Math.random()*380|0); }
    if (--pupT<=0)     { spawnPowerUp();  pupT=460+(Math.random()*420|0); }
    if (--skullT<=0)   { spawnSkull();    skullT=1400+(Math.random()*1100|0); }
    if (--eventT<=0)   { spawnWorldEvent(); eventT=900+(Math.random()*700|0); }
  }

  updateRobot();
  updateObstacles();
  updateCollectibles();
  checkCollisions();

  tickEffects(); tickParticles();
  if (shakeF>0) shakeF--;
}

// ── Evento ovni bombardero (mundo 1) ───────────────────
function updateRobot() {
  if (!robotEv) return;
  const R=robotEv;
  R.pt++;
  R.x -= 3.4;
  R.y = 96 + Math.sin(R.pt*0.06)*14;

  // suelta bombas en arco hacia ti, con aviso en el suelo
  if (R.drops<R.maxDrops && R.pt>=R.nextAt && R.x<W-80 && R.x>P.x+60) {
    const tx = P.x + 30 + (Math.random()*90-25);
    const N = 46, g = GRAVITY*0.42;
    R.bombs.push({ x:R.x, y:R.y+30, vx:(tx-R.x)/N,
                   vy:(GROUND-(R.y+30))/N - 0.5*g*(N-1),
                   g, t:0, af:0, boom:false, bt:0 });
    fx('warning', tx, GROUND-70, {life:46});
    AudioMan.sfx('cannon',{vol:0.35,rate:1.5});
    R.drops++; R.nextAt = R.pt + (hardness()>0.5?44:56);
  }

  const pr=playerRect();
  for (const bm of R.bombs) {
    bm.t++;
    if (!bm.boom) {
      bm.x+=bm.vx; bm.vy+=bm.g; bm.y+=bm.vy;
      if (bm.t%7===0) bm.af=(bm.af+1)%4;
      if (overlaps(pr.x,pr.y,pr.w,pr.h, bm.x-14,bm.y-14,28,28, 4)) { playerHit(); bm.boom=true; bm.bt=0; }
      else if (bm.y>=GROUND-12) {
        bm.boom=true; bm.bt=0;
        fx('explosion', bm.x, GROUND-26); shake(6); AudioMan.sfx('cannon',{vol:0.5});
      }
    } else {
      bm.bt++;
      if (bm.bt<14 && overlaps(pr.x,pr.y,pr.w,pr.h, bm.x-34,GROUND-56,68,56, 4)) playerHit();
    }
  }
  R.bombs=R.bombs.filter(bm=>!bm.boom || bm.bt<16);

  if (R.x<-160 && R.bombs.length===0) robotEv=null;
}

// ── Obstáculos ─────────────────────────────────────────
// tipos con velocidad propia absoluta: NO reciben el scroll del mundo
// (antes bola/cball/lowball sumaban scroll + velocidad propia y los
//  cañonazos nunca aterrizaban donde avisaban)
const OWN_MOTION = { soldier:1, bola:1, cball:1, lowball:1 };
function updateObstacles() {
  const nextObs=[];
  for (const ob of obstacles) {
    if (!OWN_MOTION[ob.type]) ob.x-=speed;
    if (ob.x<-380) continue;

    if (ob.type==='espar') {
      ob.at++;
      ob.x-=speed*0.16;
      const ph=(ob.at%46)/46;
      ob.hop = ph<0.5 ? Math.sin(ph*2*Math.PI*0.5)*26 : 0;
    }

    else if (ob.type==='parachute') {
      ob.at++;
      if (ob.at%12===0) ob.af^=1;
      if (!ob.landed) {
        ob.vy=Math.min(3.2,ob.vy+0.05);
        ob.y+=ob.vy;
        ob.x+=Math.sin(ob.at*0.08)*0.9;
        if (ob.y>=GROUND) {
          ob.y=GROUND; ob.landed=true; ob.landTimer=0;
          fx('hit', ob.x, GROUND-40);
          burst(ob.x, GROUND-30, '#c8a468', 10);
          shake(3);
        }
      } else ob.landTimer++;
    }

    else if (ob.type==='mina') {
      ob.at++;
      ob.bob=Math.sin(ob.at*0.1)*3;
    }

    else if (ob.type==='lowball') {
      ob.x+=ob.vx;
      ob.at++;
      if (ob.at%4===0) ob.af=(ob.af+1)%3;
    }

    else if (ob.type==='missile') {
      ob.at++;
      if (ob.warn>0) { ob.warn--; }
      else {
        ob.vy=Math.min(11, ob.vy+0.5);
        ob.y+=ob.vy;
        if (ob.y>=GROUND) {
          fx('explosion', ob.x, GROUND-40);
          shake(8);
          AudioMan.sfx('cannon',{vol:0.6,rate:1.3});
          if (Math.abs(P.x-ob.x)<80 && P.y>GROUND-70) playerHit();
          continue;
        }
      }
    }

    else if (ob.type==='raycol') {
      ob.at++;
      if (!ob.active && ob.x < P.x+430) {
        ob.active=true;
        AudioMan.sfx('bruja-dispara',{rate:0.8,vol:0.7});
        burst(ob.x, GROUND-8, '#dd66ff', 12);
      }
      if (ob.active) ob.eruptT++;
    }

    else if (ob.type==='gunilda-cameo') {
      ob.at++;
      ob.x-=speed*0.6;
      ob.y+=Math.sin(ob.at*0.07)*1.1;
      if (!ob.dropped && ob.x<W*0.72) {
        ob.dropped=true;
        AudioMan.sfx('bruja-dispara');
        const dx=P.x-ob.x, dy=(P.y-PH*0.5)-ob.y;
        const dd=Math.hypot(dx,dy)||1, sp2=6.5+speed*0.25;
        nextObs.push({ type:'bola', x:ob.x, y:ob.y+40, w:34, h:34, sp:sp2,
                       vx:dx/dd*sp2, vy:dy/dd*sp2, af:0, at:0, homing:45 });
      }
    }

    else if (ob.type==='witch') {
      ob.at++;
      if (ob.at%5===0) ob.af=(ob.af+1)%6;
      ob.pt++;
      ob.y += Math.sin(ob.at*0.06)*0.8;
      // mientras apunta y dispara levita quieta en pantalla:
      // ventana de reacción constante a cualquier velocidad del mundo
      if (ob.phase==='charge'||ob.phase==='shot') ob.x+=speed;
      if (ob.phase==='enter' && ob.x<W*0.78) { ob.phase='charge'; ob.pt=0; AudioMan.sfx('bruja-carga'); }
      else if (ob.phase==='charge' && ob.pt>=50) {
        ob.phase='shot'; ob.pt=0;
        AudioMan.sfx('bruja-dispara');
        const ty = ob.lowShot ? GROUND-24 : P.y-PH*0.5;
        const dx=P.x-ob.x, dy=ty-ob.y;
        const d=Math.hypot(dx,dy)||1, sp2=6.5+speed*0.25;
        nextObs.push({ type:'bola', x:ob.x, y:ob.y+50, w:34, h:34, sp:sp2,
                       vx:dx/d*sp2, vy:dy/d*sp2, af:0, at:0, homing:ob.lowShot?0:45 });
      }
      else if (ob.phase==='shot' && ob.pt>=45) { ob.phase='fade'; ob.pt=0; AudioMan.sfx('bruja-desaparece'); }
      else if (ob.phase==='fade') {
        ob.alpha-=0.04;
        if (ob.alpha<=0) continue;
      }
    }

    else if (ob.type==='bola') {
      if (ob.homing>0) {
        ob.homing--;
        const bsp=ob.sp||6.5;
        const dx=P.x-ob.x, dy=(P.y-PH*0.5)-ob.y, d=Math.hypot(dx,dy)||1;
        ob.vx+= (dx/d*bsp-ob.vx)*0.04;
        ob.vy+= (dy/d*bsp-ob.vy)*0.04;
      }
      ob.x+=ob.vx; ob.y+=ob.vy; ob.at++;
      if (ob.at%4===0) ob.af=(ob.af+1)%3;
      if (ob.x<-80||ob.y>H+60) continue;
    }

    else if (ob.type==='dog' || ob.type==='minibot') {
      ob.at++;
      if (ob.at%6===0) ob.af=(ob.af+1)%(ob.type==='dog'?5:8);
      if (!ob.fired && ob.x-P.x<400) {
        ob.fired=true; ob.attacking=60;
        AudioMan.sfx(ob.type==='dog' ? 'perro-ataque' : 'robot-rayo');
      }
      if (ob.attacking>0) ob.attacking--;
    }

    else if (ob.type==='bomb') {
      ob.at++;
      if (ob.at%5===0) ob.af=(ob.af+1)%4;
      ob.y += Math.sin(ob.at*0.08)*0.6;
    }

    else if (ob.type==='soldier') {
      ob.pt++; ob.at++;
      if (ob.at%5===0) ob.af^=1;
      if (ob.phase==='warn') {
        if (ob.pt>=70) { ob.phase='charge'; AudioMan.sfx('soldado-embiste'); }
      } else {
        ob.x -= speed*2.6;
      }
    }

    else if (ob.type==='cball') {
      ob.vy+=ob.grav; ob.x+=ob.vx; ob.y+=ob.vy; ob.at++;
      if (ob.at%4===0) ob.af=(ob.af+1)%3;
      if (ob.y>GROUND+8) { fx('splash',ob.x,GROUND); continue; }
    }

    nextObs.push(ob);
  }
  obstacles=nextObs;
}

// ── Coleccionables ─────────────────────────────────────
function updateCollectibles() {
  const pr=playerRect();
  const magnetOn = P.cat>0 || fever>0;
  coinItems=coinItems.filter(c=>{
    c.x-=speed; c.at++;
    if (c.at%5===0) c.af=(c.af+1)%7;
    if (magnetOn) {
      const dx=P.x-c.x, dy=(P.y-PH*0.5)-c.y, d=Math.hypot(dx,dy)||1;
      if (d<260) { c.x+=dx/d*9; c.y+=dy/d*9; }
    }
    if (overlaps(pr.x,pr.y,pr.w,pr.h, c.x-16,c.y-16,32,32, 2)) {
      coins++;
      combo++; comboT=180;
      misEvent('coin');
      const mult=(1+Math.floor(combo/5))*(fever>0?2:1);
      bonusPts+=5*mult;
      popup(c.x,c.y-14,'+'+(5*mult)+(mult>1?' ×'+mult:''),fever>0?'#FF851B':'#FFD700',mult>1?26:20);
      burst(c.x,c.y,'#FFD700',8);
      AudioMan.sfx('coin',{vol:0.8,rate:1+Math.min(0.6,combo*0.03)});
      if (combo>=feverNext) {
        fever=420; feverNext=combo+12;
        popup(P.x, P.y-PH-44, '🔥 ¡FIEBRE DE MONEDAS! ×2', '#FF4136', 30);
        burst(P.x, P.y-PH*0.5, '#FF851B', 18);
        AudioMan.sfx('powerup-turbo');
      }
      return false;
    }
    return c.x>-60;
  });
  gemItems=gemItems.filter(gm=>{
    gm.x-=speed; gm.at++;
    if (gm.at%6===0) gm.af=(gm.af+1)%4;
    if (overlaps(pr.x,pr.y,pr.w,pr.h, gm.x-20,gm.y-20,40,40, 2)) {
      gems++;
      burst(gm.x,gm.y,'#44ff88',10);
      AudioMan.sfx('gema');
      if (gems>=GEMS_FOR_TURBO) { gems=0; activateTurbo(); }
      return false;
    }
    return gm.x>-60;
  });
  powerUps=powerUps.filter(pu=>{
    pu.x-=speed; pu.at++;
    if (pu.at%6===0) pu.af=(pu.af+1)%8;
    if (pu.type==='skull') {
      // Eufrasio bota por el suelo
      pu.vy+=GRAVITY*0.55;
      pu.y+=pu.vy;
      if (pu.y>=GROUND-26) { pu.y=GROUND-26; pu.vy=-7; }
    }
    if (overlaps(pr.x,pr.y,pr.w,pr.h, pu.x-24,pu.y-24,48,48, 2)) {
      if (pu.type==='shield') {
        P.shielded=420;
        burst(P.x,P.y-PH*0.5,'#88ddff',16);
        AudioMan.sfx('powerup-escudo');
      } else if (pu.type==='boost') {
        activateTurbo();
      } else if (pu.type==='cat') {
        P.cat=480;
        burst(P.x,P.y-PH*0.5,'#ffb060',14);
        popup(P.x, P.y-PH-30, '¡BILLS HUELE MONEDAS!', '#ffb060', 24);
        AudioMan.sfx('powerup-escudo',{rate:1.3});
      } else if (pu.type==='skull') {
        bonusPts+=100; coins+=5;
        popup(pu.x, pu.y-30, '💀 ¡EUFRASIO! +100', '#ffee88', 26);
        burst(pu.x,pu.y,'#ffee88',14);
        AudioMan.sfx('gema',{rate:0.8});
      } else {
        AudioMan.sfx('powerup-explosion');
        shake(14);
        for (const ob of obstacles) {
          if (ob.x>-100 && ob.x<W+150) fx('explosion', ob.x, ob.y-(ob.h||60)*0.5);
        }
        obstacles=[];
      }
      return false;
    }
    return pu.x>-80;
  });
}

// ── Colisiones jugador/obstáculo ───────────────────────
function checkCollisions() {
  const pr=playerRect();
  for (const ob of obstacles) {
    if (ob.x<-200) continue;
    let bx,by,bw,bh;
    switch(ob.type) {
      case 'espar':     bx=ob.x-ob.w*0.5; by=ob.y-ob.h-(ob.hop||0); bw=ob.w; bh=ob.h; break;
      case 'parachute': if (ob.landed){bx=ob.x-36;by=ob.y-72;bw=72;bh=72;}
                        else {bx=ob.x-35;by=ob.y-60;bw=70;bh=60;} break;
      case 'mina':      bx=ob.x-28; by=ob.y-58; bw=56; bh=58; break;
      case 'lowball':   bx=ob.x-15; by=ob.y-15; bw=30; bh=30; break;
      case 'missile':   if (ob.warn>0) continue;
                        bx=ob.x-20; by=ob.y-ob.h*0.5; bw=40; bh=ob.h; break;
      case 'raycol':    if (!ob.active) continue;
                        bx=ob.x-ob.w*0.5; by=GROUND-ob.hgt; bw=ob.w; bh=ob.hgt; break;
      case 'cball':     bx=ob.x-13; by=ob.y-13; bw=26; bh=26; break;
      case 'bola':      bx=ob.x-14; by=ob.y-14; bw=28; bh=28; break;
      case 'bomb':      bx=ob.x-26; by=ob.y-26; bw=52; bh=52; break;
      case 'soldier':   if (ob.phase!=='charge') continue;
                        bx=ob.x-44; by=ob.y-ob.h; bw=ob.w; bh=ob.h; break;
      case 'minibot':
      case 'dog':
        bx=ob.x-38; by=ob.y-ob.h; bw=ob.w; bh=ob.h;
        if (ob.attacking>10 && ob.attacking<55) {
          if (overlaps(pr.x,pr.y,pr.w,pr.h, ob.x-190,GROUND-58,155,58, 6)) {
            playerHit();
            if (state===ST.DEAD) return;
          }
        }
        break;
      default: continue;
    }
    if (overlaps(pr.x,pr.y,pr.w,pr.h, bx,by,bw,bh)) {
      if (P.boosted>0) { fx('explosion', ob.x, ob.y-(ob.h||50)*0.5); ob.x=-999; shake(6); continue; }
      // Enemigos de suelo se pueden estompar desde arriba
      if ((ob.type==='espar'||ob.type==='parachute'||ob.type==='minibot'||ob.type==='dog'||ob.type==='soldier') && P.vy>1.5 && (P.y-by)<bh*0.6) {
        stompBounce();
        fx('hit', ob.x, by);
        burst(ob.x, by, '#ffcc44', 12);
        bonusPts+=30;
        popup(ob.x, by-20, '¡PISOTÓN! +30', '#FFDC00', 24);
        ob.x=-999;
        continue;
      }
      ob.x=-999;
      playerHit();
      if (state===ST.DEAD) return;
    } else if (!ob.grazed && overlaps(pr.x,pr.y,pr.w,pr.h, bx-24,by-24,bw+48,bh+48)) {
      ob.grazed=true;
      bonusPts+=15;
      misEvent('near');
      popup(P.x,P.y-PH-16,'¡Casi! +15','#7FDBFF',20);
    }
    if (!ob.dodged && bx+bw<pr.x) {
      ob.dodged=true;
      dodgeStreak++;
      misEvent('dodge');
      if (dodgeStreak%10===0) {
        popup(P.x,P.y-PH-38,'¡RACHA ×'+dodgeStreak+'!','#FF851B',30);
        AudioMan.sfx('gema');
        for (let i=0;i<7;i++) {
          coinItems.push({ x:P.x+160+i*46, y:GROUND-150-Math.sin(i/6*Math.PI)*70, at:0, af:i%7 });
        }
      }
    }
  }
}

function tickEffects() {
  effects=effects.filter(ef=>{
    ef.at++;
    if (ef.type==='explosion') { if (ef.at%3===0) ef.af++; return ef.af<12; }
    if (ef.type==='splash')    { if (ef.at%4===0) ef.af++; return ef.af<6;  }
    if (ef.type==='hit')       { if (ef.at%5===0) ef.af++; return ef.af<3;  }
    if (ef.type==='warning')   { ef.life--; if (ef.at%5===0) ef.af=(ef.af+1)%6; return ef.life>0; }
    return false;
  });
}
function tickParticles() {
  particles=particles.filter(p=>{
    p.x+=p.vx; p.y+=p.vy; p.vy+=0.22; p.life-=0.028; return p.life>0;
  });
}

// ═══════════════════════════════════════════════════════
//  DRAW — FONDOS (uno por mundo)
// ═══════════════════════════════════════════════════════
function drawBg() {
  if (world===2) {
    const sk=gi('marsSky');
    if (sk) ctx.drawImage(sk,0,0,W,GROUND);
    else { ctx.fillStyle='#f5b98a'; ctx.fillRect(0,0,W,GROUND); }
    ctx.fillStyle='rgba(255,255,255,0.7)';
    for (const s of stars) { if (s.y<GROUND-60) { ctx.globalAlpha=0.4; ctx.beginPath(); ctx.arc(s.x,s.y*0.5,s.r*0.7,0,Math.PI*2); ctx.fill(); } }
    ctx.globalAlpha=1;
    return;
  }
  if (world===0) {
    // laboratorio: pared modular en mosaico con luz fría
    const g=ctx.createLinearGradient(0,0,0,GROUND);
    g.addColorStop(0,'#2a3a58'); g.addColorStop(1,'#8fb4cc');
    ctx.fillStyle=g; ctx.fillRect(0,0,W,GROUND);
    const li=gi('lab');
    if (li) {
      const lh=GROUND*0.94, lw=li.naturalWidth*(lh/li.naturalHeight);
      const off=((bgOff*2.2)%lw+lw)%lw;
      ctx.globalAlpha=0.85;
      for (let x=-off; x<W+lw; x+=lw-4) ctx.drawImage(li,x,GROUND-lh,lw,lh);
      ctx.globalAlpha=1;
    }
    return;
  }
  const g=ctx.createLinearGradient(0,0,0,GROUND);
  g.addColorStop(0,'#0d3a7a'); g.addColorStop(0.5,'#1a6dcc'); g.addColorStop(1,'#5fc8e8');
  ctx.fillStyle=g; ctx.fillRect(0,0,W,GROUND);
  const bi=gi('bg');
  if (bi) {
    const scale=GROUND/bi.naturalHeight;
    const bw=bi.naturalWidth*scale;
    const bx=-((bgOff%bw)+bw)%bw;
    ctx.globalAlpha=0.78;
    ctx.drawImage(bi,bx,0,bw,GROUND);
    if (bx+bw<W) ctx.drawImage(bi,bx+bw,0,bw,GROUND);
    ctx.globalAlpha=1;
  }
}
function drawClouds() {
  if (world===0) return;
  for (const cl of clouds) {
    const i=gi(cl.k); if (!i) continue;
    ctx.globalAlpha=world===2?0.35:0.9;
    ctx.drawImage(i,cl.x,cl.y,cl.w,cl.h);
    ctx.globalAlpha=1;
  }
}
function drawMountains() {
  if (world===0) return;
  if (world===2) {
    const layers=[['mars3',0.35,220,0.55],['mars2',0.62,150,0.75],['mars1',1.0,120,1]];
    for (const [k,par,h,al] of layers) {
      const m=gi(k); if (!m) continue;
      const w=m.naturalWidth*(h/m.naturalHeight);
      const off=((mtnOff*par)%w+w)%w;
      ctx.globalAlpha=al;
      for (let x=-off-w;x<W+w;x+=w-2) ctx.drawImage(m,x,GROUND-h,w,h);
      ctx.globalAlpha=1;
    }
    return;
  }
  const m1=gi('mtn1');
  if (m1) {
    const h1=148, w1=m1.naturalWidth*(h1/m1.naturalHeight);
    const off1=((mtnOff*0.42)%w1+w1)%w1;
    ctx.globalAlpha=0.68;
    for (let x=-off1-w1;x<W+w1;x+=w1+6) ctx.drawImage(m1,x,GROUND-h1,w1,h1);
    ctx.globalAlpha=1;
  }
  const m2=gi('mtn2');
  if (m2) {
    const h2=192, w2=m2.naturalWidth*(h2/m2.naturalHeight);
    const off2=((mtnOff*0.88)%w2+w2)%w2;
    ctx.globalAlpha=0.84;
    for (let x=-off2-w2;x<W+w2;x+=w2+4) ctx.drawImage(m2,x,GROUND-h2,w2,h2);
    ctx.globalAlpha=1;
  }
}
function drawOcean() {
  if (world===0) {
    // suelo metálico del laboratorio
    const og=ctx.createLinearGradient(0,GROUND,0,H);
    og.addColorStop(0,'#4a5a74'); og.addColorStop(1,'#141c2c');
    ctx.fillStyle=og; ctx.fillRect(0,GROUND,W,H-GROUND);
    ctx.fillStyle='#98b0c8'; ctx.fillRect(0,GROUND,W,5);
    ctx.strokeStyle='rgba(160,190,220,0.25)'; ctx.lineWidth=2;
    const seg=90, off=(waveOff%seg+seg)%seg;
    for (let x=-off;x<W;x+=seg) { ctx.beginPath(); ctx.moveTo(x,GROUND+6); ctx.lineTo(x-24,H); ctx.stroke(); }
    ctx.lineWidth=1;
    return;
  }
  if (world===2) {
    const og=ctx.createLinearGradient(0,GROUND,0,H);
    og.addColorStop(0,'#a94a30'); og.addColorStop(1,'#4a1608');
    ctx.fillStyle=og; ctx.fillRect(0,GROUND,W,H-GROUND);
    tileH('wood', GROUND+5, 40, waveOff*0.88);
    ctx.fillStyle='#d4703f'; ctx.fillRect(0,GROUND,W,5);
    return;
  }
  const og=ctx.createLinearGradient(0,GROUND,0,H);
  og.addColorStop(0,'#1888d8'); og.addColorStop(1,'#072560');
  ctx.fillStyle=og; ctx.fillRect(0,GROUND,W,H-GROUND);
  tileH('wave', GROUND-22, 58, waveOff);
  tileH('wood', GROUND+5, 40, waveOff*0.88);
  ctx.fillStyle='#c89840'; ctx.fillRect(0,GROUND,W,5);
}
function drawScene(){ drawBg(); drawClouds(); drawMountains(); drawOcean(); }

// ═══════════════════════════════════════════════════════
//  DRAW — JUGADOR
// ═══════════════════════════════════════════════════════
// Tinte por personaje: Bruno azul, Mamá rosa (canvas offscreen, compatible Safari)
const TINTS = { 2:'rgba(70,110,255,0.45)', 3:'rgba(255,90,170,0.45)' };
const tintCache = {};
function heroImg(key) {
  const base = gi(key);
  if (!base) return null;
  const tint = TINTS[selChar];
  if (!tint) return base;
  const ck = selChar+':'+key;
  if (tintCache[ck]) return tintCache[ck];
  const c = document.createElement('canvas');
  c.width = base.naturalWidth; c.height = base.naturalHeight;
  const cx = c.getContext('2d');
  cx.drawImage(base, 0, 0);
  cx.globalCompositeOperation = 'source-atop';
  cx.fillStyle = tint;
  cx.fillRect(0, 0, c.width, c.height);
  c.naturalWidth = c.width; c.naturalHeight = c.height;
  tintCache[ck] = c;
  return c;
}
function runFrames() { return selChar===1 ? 6 : 9; }

// caza enemigo: tu misma nave, volteada y teñida de rojo (cache)
function drawAster(e) {
  const im=gi(e.big?'meteor1':'meteor2');
  ctx.save();
  ctx.translate(e.x,e.y); ctx.rotate(e.rot);
  if (im) {
    const w=e.r*2.35, h=w*im.naturalHeight/im.naturalWidth;
    if (e.hitF>0 && ctx.filter!==undefined) ctx.filter='brightness(1.9)';
    ctx.drawImage(im, -w*0.5, -h*0.5, w, h);
  } else {
    ctx.fillStyle = e.hitF>0 ? '#b8a894' : '#7d6c58';
    ctx.strokeStyle='#4a3f30'; ctx.lineWidth=3;
    ctx.beginPath();
    for (let k=0;k<9;k++) {
      const a=k/9*Math.PI*2, r=e.r*e.verts[k];
      if (k===0) ctx.moveTo(Math.cos(a)*r, Math.sin(a)*r);
      else ctx.lineTo(Math.cos(a)*r, Math.sin(a)*r);
    }
    ctx.closePath(); ctx.fill(); ctx.stroke();
  }
  ctx.restore();
  if (ctx.filter!==undefined) ctx.filter='none';
  ctx.lineWidth=1;
}

function drawRunFrame(x, y) {
  const ri=heroImg((selChar===1?'lr':'r')+(P.anim|0));
  if (!ri) { ctx.fillStyle='#3498db'; ctx.fillRect(x-PW*0.5,y-PH,PW,PH); return; }
  const w=PH*ri.naturalWidth/ri.naturalHeight;
  ctx.drawImage(ri, x-w*0.5, y-PH, w, PH);
}
function drawCatBuddy() {
  if (P.cat<=0) return;
  const cf=gi('g'+(Math.floor(gframe/4)%5));
  if (cf) {
    ctx.globalAlpha = P.cat<90 ? (Math.floor(gframe/5)%2?0.4:0.9) : 1;
    ctx.drawImage(cf, P.x-118, GROUND-34, 66, 30);
    ctx.globalAlpha = 1;
  }
}
function drawPlayer() {
  const pr=playerRect();
  const onGround=P.y>=GROUND-2;
  const isDuck=P.ducking&&onGround;
  const flicker=P.invincible>0 && Math.floor(gframe/4)%2===1;

  drawCatBuddy();
  if (flicker) ctx.globalAlpha=0.3;

  if (P.boosted>0) {
    const wf=gi('wind'+(Math.floor(gframe/4)%4));
    if (wf) {
      const oldA=ctx.globalAlpha;
      ctx.globalAlpha=Math.min(oldA,0.8);
      ctx.drawImage(wf, P.x-115, P.y-PH-8, 100, PH+16);
      ctx.globalAlpha=oldA;
    }
  }

  if (P.shielded>0) {
    const si=gi('shield'+(Math.floor(gframe/4)%9));
    if (si) {
      const oldA=ctx.globalAlpha;
      ctx.globalAlpha=Math.min(oldA,0.55);
      ctx.drawImage(si, pr.x-22, pr.y-14, pr.w+44, pr.h+28);
      ctx.globalAlpha=oldA;
    }
  }

  if (state===ST.DEAD) {
    const sp=heroImg('splat');
    if (sp) ctx.drawImage(sp, P.x-55, P.y-PH-18, 96, PH+40);
  } else if (state===ST.INTRO && !introShip && introF>=45 && introF<90) {
    const ji=heroImg(selChar===1?'ljump':'mjump');
    ctx.save();
    ctx.translate(P.x,P.y-PH*0.5);
    ctx.rotate(((introF-45)/45)*Math.PI*2);
    if (ji) {
      const jw=PH*ji.naturalWidth/ji.naturalHeight;
      ctx.drawImage(ji,-jw*0.5,-PH*0.5,jw,PH);
    }
    ctx.restore();
  } else if (!onGround) {
    const ji=heroImg(selChar===1?'ljump':'mjump');
    if (ji) {
      const jw=PH*ji.naturalWidth/ji.naturalHeight;
      ctx.drawImage(ji, P.x-jw*0.5, P.y-PH, jw, PH);
    } else drawRunFrame(P.x,P.y);
  } else if (isDuck) {
    ctx.save();
    ctx.translate(P.x,P.y);
    ctx.scale(1,0.55);
    drawRunFrame(0,0);
    ctx.restore();
  } else if (P.boosted>0) {
    const ti=heroImg('tur'+(Math.floor(gframe/4)%2));
    if (ti) ctx.drawImage(ti, P.x-PW*0.62, P.y-PH-4, PW*1.3, PH+4);
    else drawRunFrame(P.x,P.y);
  } else {
    drawRunFrame(P.x,P.y);
  }

  ctx.globalAlpha=1;
}

// ═══════════════════════════════════════════════════════
//  DRAW — OBSTÁCULOS / ROBOT / CAMEO
// ═══════════════════════════════════════════════════════
function drawBeamH(imgKey, frame, y, xEnd, thick, alpha, xStart=0) {
  const ri=gi(imgKey+frame);
  ctx.globalAlpha=alpha;
  if (ri) {
    const tw=thick*ri.naturalHeight/ri.naturalWidth;
    for (let x=xStart; x<xEnd; x+=tw*0.85) {
      ctx.save();
      ctx.translate(x+tw*0.5, y);
      ctx.rotate(-Math.PI/2);
      ctx.drawImage(ri, -thick*0.5, -tw*0.5, thick, tw);
      ctx.restore();
    }
  } else {
    ctx.fillStyle='#8feaff';
    ctx.fillRect(xStart, y-thick*0.5, xEnd-xStart, thick);
  }
  ctx.globalAlpha=1;
}

function drawRobot() {
  if (!robotEv) return;
  const R=robotEv;
  // bombas pinchudas girando
  for (const bm of R.bombs) {
    if (bm.boom) continue;
    ctx.save();
    ctx.translate(bm.x, bm.y);
    ctx.rotate(bm.t*0.1);
    di('bomb'+bm.af, -16, -16, 32, 32);
    ctx.restore();
  }
  const u=gi('ufo');
  if (u) {
    ctx.save();
    ctx.translate(R.x, R.y);
    ctx.rotate(Math.sin(R.pt*0.07)*0.12);
    ctx.drawImage(u, -42, -42, 84, 84);
    ctx.restore();
    // luz roja parpadea justo antes de soltar bomba
    if (R.drops<R.maxDrops && R.nextAt-R.pt<18 && Math.floor(gframe/4)%2===0) {
      ctx.fillStyle='#FF4136';
      ctx.beginPath(); ctx.arc(R.x, R.y+36, 6, 0, Math.PI*2); ctx.fill();
    }
  }
}
function drawCameo() {
  if (!cameo) return;
  const g2=gi('gorilla');
  if (g2) {
    const bob=Math.sin(cameo.at*0.3)*2;
    ctx.drawImage(g2, cameo.x-48, GROUND-88+bob, 96, 88);
    if (!cameo.said && cameo.x<W-160) {
      cameo.said=true;
      popup(cameo.x, GROUND-110, '¡Papa Gorila al rescate!', '#ffcc88', 20);
    }
  }
}

function drawObstacles() {
  for (const ob of obstacles) {
    if (ob.x<-380||ob.x>W+320) continue;

    if (ob.type==='espar') {
      const ei=gi('espar');
      if (ei) {
        const hop=ob.hop||0;
        const stretch = hop>2 ? 1.08 : (ob.at%46)>40 ? 0.9 : 1;
        ctx.save();
        ctx.translate(ob.x, ob.y-hop);
        ctx.rotate(Math.sin(ob.at*0.14)*0.07);
        ctx.scale(-(2-stretch), stretch);   // volteado: corre mirando al jugador
        ctx.drawImage(ei, -ob.w*0.5, -ob.h, ob.w, ob.h);
        ctx.restore();
      }
    }
    else if (ob.type==='parachute') {
      const pi=gi(ob.af===0?'pirata0':'pirata1');
      if (pi) {
        if (ob.landed) {
          const sy=pi.naturalHeight*0.46, sh=pi.naturalHeight*0.54;
          const dh=78;
          ctx.save();
          ctx.translate(ob.x, ob.y);
          ctx.rotate(Math.sin(ob.landTimer*0.15)*0.06);
          ctx.drawImage(pi, 0, sy, pi.naturalWidth, sh, -42, -dh, 84, dh);
          ctx.restore();
        } else {
          ctx.save();
          ctx.translate(ob.x, ob.y-ob.h*0.5);
          ctx.rotate(Math.sin(ob.at*0.08)*0.12);
          ctx.drawImage(pi, -45, -ob.h*0.5, ob.w, ob.h);
          ctx.restore();
        }
      }
    }
    else if (ob.type==='mina') {
      // bomba pinchuda varada en la arena
      const mi=gi('bomb'+(Math.floor(ob.at/6)%4));
      const bob=ob.bob||0;
      if (mi) ctx.drawImage(mi, ob.x-32, ob.y-64+bob, 64, 64);
      else { ctx.fillStyle='#333'; ctx.beginPath(); ctx.arc(ob.x,ob.y-30+bob,26,0,Math.PI*2); ctx.fill(); }
    }
    else if (ob.type==='lowball') {
      const bi=gi('cb'+ob.af);
      if (bi) {
        ctx.save();
        ctx.translate(ob.x,ob.y);
        ctx.rotate(Math.PI/2);
        ctx.drawImage(bi,-14,-22,28,44);
        ctx.restore();
      } else { ctx.fillStyle='#222'; ctx.beginPath(); ctx.arc(ob.x,ob.y,15,0,Math.PI*2); ctx.fill(); }
    }
    else if (ob.type==='missile') {
      if (ob.warn>0) {
        if (Math.floor(ob.at/6)%2===0) {
          ctx.save();
          ctx.fillStyle='rgba(255,60,40,0.8)';
          ctx.beginPath();
          ctx.moveTo(ob.x,GROUND-34); ctx.lineTo(ob.x-16,GROUND-6); ctx.lineTo(ob.x+16,GROUND-6);
          ctx.closePath(); ctx.fill();
          ctx.fillStyle='#fff'; ctx.font='bold 20px sans-serif'; ctx.textAlign='center';
          ctx.fillText('!', ob.x, GROUND-12);
          ctx.restore();
          ctx.textAlign='left';
        }
      } else {
        const mi=gi('missile');
        if (mi) {
          ctx.save();
          ctx.translate(ob.x, ob.y);
          ctx.rotate(Math.PI);
          ctx.drawImage(mi, -ob.w*0.5, -ob.h*0.5, ob.w, ob.h);
          ctx.restore();
        }
      }
    }
    else if (ob.type==='raycol') {
      if (!ob.active) {
        // runa en el suelo parpadeando: aquí brotará el géiser
        if (Math.floor(ob.at/6)%2===0) {
          ctx.fillStyle='rgba(221,102,255,0.5)';
          ctx.beginPath();
          ctx.ellipse(ob.x, GROUND-5, ob.w*0.85, 10, 0, 0, Math.PI*2);
          ctx.fill();
          ctx.fillStyle='#dd66ff'; ctx.font='bold 22px sans-serif'; ctx.textAlign='center';
          ctx.fillText('!', ob.x, GROUND-14);
          ctx.textAlign='left';
        }
      } else {
        const h2=ob.hgt*Math.min(1, ob.eruptT/7);
        const mf=gi('magia'+(Math.floor(ob.at/3)%6));
        ctx.globalAlpha=0.92;
        if (mf) {
          for (let y=GROUND-h2; y<GROUND; y+=86) ctx.drawImage(mf, ob.x-ob.w*0.65, y, ob.w*1.3, Math.min(92, GROUND-y+2));
        } else {
          ctx.fillStyle='#dd66ff';
          ctx.fillRect(ob.x-ob.w*0.5, GROUND-h2, ob.w, h2);
        }
        ctx.globalAlpha=1;
      }
    }
    else if (ob.type==='gunilda-cameo') {
      const gf=gi('gun'+(Math.floor(ob.at/6)%3));
      if (gf) {
        const gh=86, gw=gh*gf.naturalWidth/gf.naturalHeight;
        ctx.save();
        ctx.translate(ob.x, ob.y);
        ctx.rotate(Math.sin(ob.at*0.05)*0.08);
        ctx.scale(-1,1);
        ctx.drawImage(gf, -gw*0.5, -gh*0.5, gw, gh);
        ctx.restore();
      }
    }
    else if (ob.type==='witch') {
      ctx.globalAlpha=Math.max(0, ob.alpha);
      const wi=gi('bruja'+ob.af);
      if (wi) {
        ctx.save();
        if (ob.phase==='charge') { ctx.shadowColor='#dd66ff'; ctx.shadowBlur=16+Math.sin(ob.pt*0.4)*8; }
        ctx.drawImage(wi, ob.x-41, ob.y, 82, 100);
        ctx.restore();
      }
      ctx.globalAlpha=1;
    }
    else if (ob.type==='bola') {
      const bi=gi('bola'+ob.af);
      if (bi) ctx.drawImage(bi, ob.x-19, ob.y-19, 38, 38);
      else { ctx.fillStyle='#cc2244'; ctx.beginPath(); ctx.arc(ob.x,ob.y,14,0,Math.PI*2); ctx.fill(); }
    }
    else if (ob.type==='dog') {
      const dgi=gi('dog'+ob.af);
      if (dgi) ctx.drawImage(dgi, ob.x-41, ob.y-ob.h, 82, ob.h);
      if (ob.attacking>10 && ob.attacking<55) {
        const fi=gi('fuego'+(Math.floor(ob.at/4)%3));
        if (fi) ctx.drawImage(fi, ob.x-205, ob.y-72, 175, 76);
      }
    }
    else if (ob.type==='minibot') {
      // torreta de seguridad del laboratorio
      const ti=gi('turret');
      if (ti) {
        ctx.save();
        if (ob.attacking>50) { ctx.shadowColor='#8feaff'; ctx.shadowBlur=16; }
        ctx.drawImage(ti, ob.x-53, ob.y-50, 107, 50);
        ctx.restore();
        if (!ob.fired && Math.floor(ob.at/9)%2===0) {
          ctx.fillStyle='#FF4136';
          ctx.beginPath(); ctx.arc(ob.x+28, ob.y-36, 5, 0, Math.PI*2); ctx.fill();
        }
      }
      if (ob.attacking>10 && ob.attacking<55) {
        const li=gi('flaser'+(Math.floor(ob.at/4)%5));
        if (li) {
          const th=36, tw2=th*li.naturalHeight/li.naturalWidth;
          for (let lx=ob.x-205; lx<ob.x-35; lx+=tw2*0.85) {
            ctx.save(); ctx.translate(lx+tw2*0.5, GROUND-27); ctx.rotate(-Math.PI/2);
            ctx.drawImage(li, -th*0.5, -tw2*0.5, th, tw2); ctx.restore();
          }
        } else { ctx.fillStyle='#8feaff'; ctx.fillRect(ob.x-205, GROUND-45, 175, 30); }
      }
    }
    else if (ob.type==='bomb') {
      const bi=gi('bomb'+ob.af);
      if (bi) ctx.drawImage(bi, ob.x-31, ob.y-31, 62, 62);
    }
    else if (ob.type==='soldier') {
      if (ob.phase==='warn') {
        const wi=gi('soldierWarn');
        if (wi && Math.floor(ob.pt/7)%2===0) ctx.drawImage(wi, W-108, GROUND-176, 92, 88);
      } else {
        const mi=gi(ob.af===0?'moto0':'moto1');
        if (mi) ctx.drawImage(mi, ob.x-48, ob.y-ob.h, ob.w, ob.h);
      }
    }
    else if (ob.type==='cball') {
      const cbi=gi('cb'+ob.af);
      if (cbi) {
        ctx.save();
        ctx.translate(ob.x,ob.y);
        ctx.rotate(Math.atan2(ob.vy,ob.vx));
        ctx.drawImage(cbi,-14,-22,28,44);
        ctx.restore();
      }
    }
  }
}

// ═══════════════════════════════════════════════════════
//  DRAW — COLECCIONABLES / EFECTOS
// ═══════════════════════════════════════════════════════
function drawCollectibles() {
  for (const c of coinItems) {
    const ci=gi('c'+c.af);
    if (ci) ctx.drawImage(ci, c.x-18, c.y-18, 36, 36);
  }
  for (const gm of gemItems) {
    const g2=gi('gem'+gm.af);
    // halo barato (sin shadowBlur, mata el rendimiento en tablets)
    ctx.globalAlpha=0.25+Math.sin(gframe*0.15)*0.1;
    ctx.fillStyle='#44ff88';
    ctx.beginPath(); ctx.arc(gm.x, gm.y, 26, 0, Math.PI*2); ctx.fill();
    ctx.globalAlpha=1;
    if (g2) ctx.drawImage(g2, gm.x-20, gm.y-20, 40, 40);
  }
  for (const pu of powerUps) {
    const pulse=1+Math.sin(gframe*0.14)*0.06, sz=48*pulse;
    ctx.save();
    const halo = pu.type==='shield'?'#44aaff':pu.type==='boost'?'#ffaa22':pu.type==='cat'?'#ffb060':pu.type==='skull'?'#ffee88':'#ff5533';
    ctx.globalAlpha=0.22+Math.sin(gframe*0.12)*0.08;
    ctx.fillStyle=halo;
    ctx.beginPath(); ctx.arc(pu.x, pu.y, sz*0.62, 0, Math.PI*2); ctx.fill();
    ctx.globalAlpha=1;
    if (pu.type==='shield') {
      const ei=gi('escudo'+pu.af);
      if (ei) ctx.drawImage(ei, pu.x-sz*0.5, pu.y-sz*0.6, sz, sz*1.3);
    } else if (pu.type==='boost') {
      const bi2=gi('boost'+(pu.af%5));
      if (bi2) ctx.drawImage(bi2, pu.x-sz*0.5, pu.y-sz*0.5, sz, sz);
    } else if (pu.type==='cat') {
      const cf=gi('g'+(Math.floor(gframe/5)%5));
      if (cf) ctx.drawImage(cf, pu.x-sz*0.6, pu.y-sz*0.35, sz*1.2, sz*0.7);
    } else if (pu.type==='skull') {
      const sk=gi('skull');
      if (sk) {
        ctx.save();
        ctx.translate(pu.x,pu.y);
        ctx.rotate(Math.sin(pu.at*0.15)*0.25);
        ctx.drawImage(sk, -sz*0.55, -sz*0.45, sz*1.1, sz*0.8);
        ctx.restore();
      }
    } else {
      const ex=gi('exp2');
      if (ex) ctx.drawImage(ex, pu.x-sz*0.5, pu.y-sz*0.5, sz, sz);
    }
    if (pu.type!=='skull') {
      const bu=gi('burb'+(Math.floor(gframe/5)%14));
      if (bu) { ctx.globalAlpha=0.45; ctx.drawImage(bu, pu.x-sz*0.75, pu.y-sz*0.75, sz*1.5, sz*1.5); ctx.globalAlpha=1; }
    }
    ctx.restore();
  }
}
function drawEffects() {
  for (const ef of effects) {
    if (ef.type==='explosion') {
      const ei2=gi('exp'+Math.min(11,ef.af));
      if (ei2) ctx.drawImage(ei2, ef.x-50, ef.y-50, 100, 100);
    } else if (ef.type==='splash') {
      const si=gi('splash'+Math.min(5,ef.af));
      if (si) ctx.drawImage(si, ef.x-24, ef.y-48, 48, 50);
    } else if (ef.type==='hit') {
      const hi=gi('hit'+Math.min(2,ef.af));
      if (hi) { ctx.globalAlpha=0.88; ctx.drawImage(hi, ef.x-44, ef.y-50, 88, 104); ctx.globalAlpha=1; }
    } else if (ef.type==='warning') {
      const wf=gi('warn'+ef.af);
      ctx.globalAlpha=Math.min(1, ef.life/18);
      if (wf) ctx.drawImage(wf, ef.x-26, ef.y-32, 52, 52);
      ctx.globalAlpha=1;
    }
  }
}
function drawParticles() {
  for (const p of particles) {
    ctx.globalAlpha=Math.max(0,p.life);
    ctx.fillStyle=p.color;
    ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2); ctx.fill();
  }
  ctx.globalAlpha=1;
}

// ═══════════════════════════════════════════════════════
//  DRAW — JEFES
// ═══════════════════════════════════════════════════════
function drawBossBar(x,y,hp,maxHp,name) {
  const bw2=220, bx2=x-bw2*0.5, by2=y;
  ctx.fillStyle='rgba(0,0,0,0.55)'; roundRect(bx2,by2,bw2,13,6); ctx.fill();
  ctx.fillStyle='#ff5544'; roundRect(bx2+2,by2+2,(bw2-4)*Math.max(0,hp/maxHp),9,4); ctx.fill();
  if (name) {
    ctx.fillStyle='#fff'; ctx.font='bold 13px system-ui,sans-serif'; ctx.textAlign='center';
    ctx.fillText(name, x, by2-5);
    ctx.textAlign='left';
  }
}
function drawBossRobot() {
  const R=RB;
  // sombra en el suelo: permite leer dónde va a aterrizar
  if (R.x<W+40) {
    const air=Math.max(0, (GROUND-90)-R.y);
    ctx.globalAlpha=Math.max(0.08, 0.28-air*0.0006);
    ctx.fillStyle='#000';
    ctx.beginPath(); ctx.ellipse(R.x, GROUND-4, Math.max(28, 62-air*0.06), 9, 0, 0, Math.PI*2); ctx.fill();
    ctx.globalAlpha=1;
  }
  // ondas sísmicas
  for (const wv of R.waves) {
    if (wv.d>0) continue;
    ctx.globalAlpha=0.9;
    ctx.strokeStyle='#ff9933'; ctx.lineWidth=5;
    for (let k=0;k<3;k++) {
      ctx.beginPath();
      ctx.arc(wv.x+k*10, GROUND, 15+k*9, Math.PI, Math.PI*2);
      ctx.stroke();
    }
    ctx.lineWidth=1; ctx.globalAlpha=1;
    if (gframe%3===0) burst(wv.x, GROUND-8, '#ffbb55', 2);
  }
  // bombas en arco
  for (const bm of R.bombs) {
    if (bm.boom) continue;
    ctx.save(); ctx.translate(bm.x,bm.y); ctx.rotate(bm.t*0.12);
    di('bomb'+bm.af, -17, -17, 34, 34);
    ctx.restore();
  }
  const rb=gi('robot'+R.af);
  if (rb) {
    const rh=180, rw=rh*rb.naturalWidth/rb.naturalHeight;
    ctx.save();
    ctx.translate(R.x, R.y);
    if (R.phase==='charge') ctx.rotate(-0.16);                                    // embiste inclinado
    if (R.phase==='quakePrep'||R.phase==='chargePrep') ctx.translate(Math.random()*5-2.5, 0);  // tiembla
    if (R.hitFlash>0 && ctx.filter!==undefined) ctx.filter='brightness(2.2)';
    ctx.drawImage(rb, -rw*0.5, -rh*0.5, rw, rh);
    ctx.restore();
    if (ctx.filter!==undefined) ctx.filter='none';
  }
  // estrellitas girando = aturdido (código universal de los videojuegos)
  if (R.phase==='stunned') {
    ctx.fillStyle='#FFDC00'; ctx.font='20px sans-serif'; ctx.textAlign='center';
    for (let k=0;k<3;k++) {
      const a=gframe*0.12+k*2.1;
      ctx.fillText('★', R.x+Math.cos(a)*44, R.y-104+Math.sin(a)*10);
    }
    ctx.textAlign='left';
  }
  if (R.phase==='stunned' && Math.floor(gframe/8)%2===0) {
    ctx.fillStyle='#7CFC00'; ctx.font='bold 22px "Baloo 2",sans-serif'; ctx.textAlign='center';
    ctx.fillText('¡SALTA ENCIMA!', R.x, R.y-142);
    ctx.textAlign='left';
  }
  drawBossBar(R.x, R.y-160, R.hp, R.maxHp, 'ROBOT GUARDIÁN');
}
function drawBossFrog() {
  const B=FB;
  if (B.phase==='laser') {
    const active=B.t>20;
    drawBeamH('flaser', Math.floor(B.t/3)%5, B.laserY, B.x-70,
              active?58:14, active?0.95:0.3+0.2*Math.sin(B.t*0.8));
  }
  if (B.phase==='fight') {
    const cycle=Math.max(150,260-lap*30);
    if (B.laserT>cycle-60) {
      ctx.save();
      ctx.shadowColor='#ff4444'; ctx.shadowBlur=20;
      ctx.fillStyle=`rgba(255,80,80,${0.4+0.3*Math.sin(B.laserT*0.5)})`;
      ctx.beginPath(); ctx.arc(B.x-95, B.y, 16, 0, Math.PI*2); ctx.fill();
      ctx.restore();
    }
  }
  for (const bu of B.bubbles) {
    const bimg=gi('burb'+(Math.floor(bu.t/4)%14));
    if (bimg) ctx.drawImage(bimg, bu.x-26, bu.y-26, 52, 52);
    else { ctx.strokeStyle='#a8e6ff'; ctx.beginPath(); ctx.arc(bu.x,bu.y,22,0,Math.PI*2); ctx.stroke(); }
  }
  if (B.phase!=='dying' || B.t<60) {
    const fi=gi('frog'+B.af);
    ctx.save();
    if (B.flash>0 && ctx.filter!==undefined) ctx.filter='brightness(2.2)';
    if (fi) {
      const fh=150, fw=fh*fi.naturalWidth/fi.naturalHeight;
      ctx.translate(B.x, B.y);
      ctx.drawImage(fi, -fw*0.5, -fh*0.5, fw, fh);
    }
    ctx.restore();
    if (ctx.filter!==undefined) ctx.filter='none';
    drawBossBar(B.x, B.y-105, B.hp, B.maxHp, 'BUBEADO');
  }
  for (const b of B.bullets) {
    const bi=gi('bullet');
    if (bi) ctx.drawImage(bi, b.x-16, b.y-8, 32, 16);
    else { ctx.fillStyle='#aaffcc'; ctx.fillRect(b.x-12,b.y-4,24,8); }
  }
  drawPlayerShip(B.shipX, B.shipY, Math.max(-0.2,Math.min(0.2,(B.nav.ty-B.shipY)*0.006)));
}
function drawPlayerShip(sx, sy, tilt=0) {
  const shi=gi('ship');
  if (shi) {
    const sw2=120, sh2=sw2*shi.naturalHeight/shi.naturalWidth;
    if (P.invincible>0 && Math.floor(gframe/4)%2===1) ctx.globalAlpha=0.35;
    ctx.save();
    ctx.translate(sx, sy); ctx.rotate(tilt);
    ctx.drawImage(shi, -sw2*0.5, -sh2*0.5, sw2, sh2);
    ctx.restore();
    ctx.globalAlpha=1;
  }
  if (P.shielded>0) {
    const si=gi('shield'+(Math.floor(gframe/4)%9));
    if (si) { ctx.globalAlpha=0.5; ctx.drawImage(si, sx-70, sy-58, 140, 116); ctx.globalAlpha=1; }
  }
}
function drawBossGunilda() {
  const G=GB;
  ctx.globalAlpha=Math.max(0,G.alpha);
  const gf = G.phase==='tired' ? gi('brunilda') : gi('gun'+G.af);
  if (gf) {
    const gh=G.phase==='tired'?115:110, gw=gh*gf.naturalWidth/gf.naturalHeight;
    ctx.save();
    if (G.phase==='cast') { ctx.shadowColor='#dd66ff'; ctx.shadowBlur=18+Math.sin(G.t*0.4)*8; }
    if (G.phase==='tired') { ctx.shadowColor='#ffee55'; ctx.shadowBlur=12; }
    if (G.hitFlash>0 && ctx.filter!==undefined) ctx.filter='brightness(2.2)';
    ctx.translate(G.x, G.y);
    ctx.scale(-1,1);
    ctx.drawImage(gf, -gw*0.5, -gh*0.5, gw, gh);
    ctx.restore();
    if (ctx.filter!==undefined) ctx.filter='none';
  }
  // chispas mágicas alrededor mientras lanza
  if (G.phase==='cast' && gframe%3===0) {
    const sf=gi('shine'+(Math.floor(gframe/4)%6));
    if (sf) { ctx.globalAlpha=0.75; ctx.drawImage(sf, G.x-70+Math.random()*140-20, G.y-70+Math.random()*140-20, 40, 40); }
  }
  ctx.globalAlpha=1;
  drawBossBar(G.x, G.y-92, G.hp, G.maxHp, 'GUNILDA');
}

// ═══════════════════════════════════════════════════════
//  DRAW — EMBARQUE / VUELO / DUELO
// ═══════════════════════════════════════════════════════
function drawShipEmpty(x0, y0, w2) {
  // el sprite de la nave trae al piloto pintado: recortamos el casco
  // y tapamos la cabina con una cúpula de cristal opaca
  const shi=gi('ship'); if (!shi) return;
  const h2=w2*shi.naturalHeight/shi.naturalWidth;
  ctx.save();
  ctx.beginPath(); ctx.rect(x0, y0+h2*0.40, w2, h2*0.60); ctx.clip();
  ctx.drawImage(shi, x0, y0, w2, h2);
  ctx.restore();
  const dg=ctx.createLinearGradient(0, y0-h2*0.05, 0, y0+h2*0.66);
  dg.addColorStop(0,'#dcf3ff'); dg.addColorStop(1,'#569fd2');
  ctx.beginPath();
  ctx.ellipse(x0+w2*0.42, y0+h2*0.30, w2*0.27, h2*0.34, 0, 0, Math.PI*2);
  ctx.fillStyle=dg; ctx.fill();
  ctx.strokeStyle='#2a6a9a'; ctx.lineWidth=3; ctx.stroke();
  ctx.beginPath();
  ctx.ellipse(x0+w2*0.34, y0+h2*0.16, w2*0.06, h2*0.10, -0.5, 0, Math.PI*2);
  ctx.fillStyle='rgba(255,255,255,0.8)'; ctx.fill();
}
function drawBoarding() {
  drawScene();
  drawEffects(); drawParticles();
  const b=BD;
  const shi=gi('ship');
  if (shi) {
    const sw2=130, sh2=sw2*shi.naturalHeight/shi.naturalWidth;
    const wob=b.phase==='land'||b.phase==='takeoff' ? Math.sin(b.t*0.2)*3 : 0;
    const sx0=b.shipX-sw2*0.5, sy0=b.shipY-sh2*0.5+wob;
    if (b.phase==='takeoff') {
      ctx.drawImage(shi, sx0, sy0, sw2, sh2);   // el piloto del sprite ES el héroe a bordo
    } else {
      drawShipEmpty(sx0, sy0, sw2);
    }
  }
  if (b.phase!=='takeoff') drawPlayer();
  drawFloatTexts();
  drawHUD();
  if (b.phase==='run'||b.phase==='land') {
    ctx.fillStyle='rgba(0,0,20,0.55)'; roundRect(W/2-190,64,380,36,10); ctx.fill();
    ctx.fillStyle='#7FDBFF'; ctx.font='bold 19px "Baloo 2",sans-serif'; ctx.textAlign='center';
    ctx.fillText('¡Corre a la nave y sube a bordo!', W/2, 88);
    ctx.textAlign='left';
  }
}
function drawSpaceBg(mode) {
  // mode 0 = espacio (vuelo), 1 = cielo de Marte (duelo)
  if (mode===1) {
    const sk=gi('marsSky');
    if (sk) ctx.drawImage(sk,0,0,W,H);
    else { ctx.fillStyle='#7a2810'; ctx.fillRect(0,0,W,H); }
    ctx.fillStyle='rgba(30,6,2,0.35)'; ctx.fillRect(0,0,W,H);
  } else {
    const g=ctx.createLinearGradient(0,0,0,H);
    g.addColorStop(0,'#020208'); g.addColorStop(1,'#0a1030');
    ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
  }
  ctx.fillStyle='#fff';
  for (const s of stars) {
    ctx.globalAlpha=mode===1?0.35:0.9;
    ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,Math.PI*2); ctx.fill();
  }
  ctx.globalAlpha=1;
}
function drawFly() {
  drawSpaceBg(0);
  const f=F;

  for (const c of f.coins) di('c'+c.af, c.x-18, c.y-18, 36, 36);

  // power-ups: cápsula VERDE inconfundible — los proyectiles enemigos nunca son verdes
  for (const pu of f.pups) {
    const pul=0.75+0.25*Math.sin(gframe*0.15);
    ctx.save();
    ctx.translate(pu.x, pu.y);
    ctx.globalAlpha=0.22*pul;
    ctx.fillStyle='#2ECC40';
    ctx.beginPath(); ctx.arc(0, 0, 40, 0, Math.PI*2); ctx.fill();
    ctx.globalAlpha=0.92;
    ctx.fillStyle='#0c3d1e';
    roundRect(-26, -22, 52, 44, 12); ctx.fill();
    ctx.strokeStyle='#2ECC40'; ctx.lineWidth=3.5;
    roundRect(-26, -22, 52, 44, 12); ctx.stroke();
    ctx.lineWidth=1; ctx.globalAlpha=1;
    ctx.restore();
    if (pu.type==='shield') di('escudo0', pu.x-13, pu.y-17, 26, 34);
    else {
      const bi=gi('bullet');
      if (bi) {
        if (pu.type==='double') { ctx.drawImage(bi,pu.x-16,pu.y-13,30,12); ctx.drawImage(bi,pu.x-16,pu.y+1,30,12); }
        else if (pu.type==='spread') {
          ctx.save(); ctx.translate(pu.x,pu.y);
          for (let k=-1;k<=1;k++){ ctx.save(); ctx.rotate(k*0.5); ctx.drawImage(bi,-14,-6,30,12); ctx.restore(); }
          ctx.restore();
        } else {
          ctx.drawImage(bi,pu.x-21,pu.y-6,28,11); ctx.drawImage(bi,pu.x-4,pu.y-6,28,11);
        }
      }
    }
  }

  // enemigos
  for (const e of f.foes) {
    if (e.kind==='aster') { drawAster(e); continue; }
    ctx.save();
    if (e.hitF>0) ctx.globalAlpha=0.55;
    if (e.kind==='mine') {
      ctx.translate(e.x,e.y); ctx.rotate(e.rot);
      di('bomb'+e.af, -26, -26, 52, 52);
    } else if (e.kind==='drone') {
      const im=gi('ufo');
      if (im) {
        ctx.translate(e.x,e.y);
        ctx.rotate(Math.sin((e.ph||0)+gframe*0.09)*0.14);   // balanceo de platillo
        ctx.drawImage(im, -30, -30, 60, 60);
      }
      else { ctx.fillStyle='#c0c8ff'; ctx.beginPath(); ctx.arc(e.x,e.y,24,0,Math.PI*2); ctx.fill(); }
    } else {
      const im=gi(f.theme===0?'foe1':'foe2');
      if (im) { const ww=90, hh2=ww*im.naturalHeight/im.naturalWidth; ctx.drawImage(im, e.x-ww*0.5, e.y-hh2*0.5, ww, hh2); }
      else { ctx.fillStyle='#ff6655'; ctx.beginPath(); ctx.arc(e.x,e.y,30,0,Math.PI*2); ctx.fill(); }
    }
    ctx.restore();
  }

  if (f.boss) drawFlyBoss();

  // disparos enemigos
  for (const s of f.shots) {
    if (s.spr==='missile') {
      const mi=gi('missile');
      if (mi) {
        ctx.save(); ctx.translate(s.x,s.y);
        ctx.rotate(Math.atan2(s.vy,s.vx)+Math.PI/2);
        ctx.drawImage(mi,-14,-24,28,48);
        ctx.restore();
      }
    } else if (s.spr==='burb') {
      di('burb'+s.af, s.x-24, s.y-24, 48, 48);
    } else if (s.spr==='bola') {
      di('bola'+(s.af%3), s.x-18, s.y-18, 36, 36);
    } else if (s.spr==='laser') {
      // bolt láser de la Nodriza: cápsula roja con núcleo claro
      ctx.globalAlpha=0.9;
      ctx.fillStyle='#ff3b30';
      roundRect(s.x-24, s.y-7, 48, 14, 7); ctx.fill();
      ctx.fillStyle='#ffd9a0';
      roundRect(s.x-14, s.y-3, 28, 6, 3); ctx.fill();
      ctx.globalAlpha=1;
    } else {
      di('cb'+(s.af%3), s.x-16, s.y-16, 32, 32);
    }
  }

  // balas de la nave
  const bi2=gi('bullet');
  for (const b of f.bullets) {
    if (bi2) {
      ctx.save(); ctx.translate(b.x,b.y);
      if (b.vy) ctx.rotate(Math.atan2(b.vy,b.vx));
      ctx.drawImage(bi2,-16,-7,32,14);
      ctx.restore();
    } else { ctx.fillStyle='#7FDBFF'; ctx.fillRect(b.x-10,b.y-3,20,6); }
  }

  // estela de la nave
  if (gframe%2===0) particles.push({ x:f.x-40, y:f.y+8, vx:-4-Math.random()*2, vy:(Math.random()-0.5)*1.4,
