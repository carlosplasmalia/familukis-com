const keys = {};
document.addEventListener('keydown', e => {
  keys[e.code]=true;
  AudioMan.unlock();
  if (e.code==='Space'||e.code==='ArrowUp') { e.preventDefault(); handleAction(); }
  if (e.code==='ArrowDown'||e.code==='KeyS') { e.preventDefault(); if (!e.repeat) doSlam(); P.ducking=true; }
  if (e.code==='KeyM') AudioMan.toggleMute();
});
document.addEventListener('keyup', e => {
  keys[e.code]=false;
  if (e.code==='ArrowDown'||e.code==='KeyS') P.ducking=false;
});

let pointerDown=false, pointerX=W/2, pointerY=H/2;
let dragDX=0, dragDY=0;          // deltas del dedo acumulados (pilotar la nave)
let touchY0=0, swiped=false, duckT=0;

// plancha: en el aire cae en picado (y estompa lo que pille debajo);
// en el suelo, agacharse un momento — accesible por swipe en táctil
function doSlam() {
  if (P.dead) return;
  if (state!==ST.PLAYING && !(state===ST.BOSS && !FB)) return;
  if (P.y<GROUND-4) {
    P.vy=Math.max(P.vy,15);
    for (let i=0;i<5;i++) particles.push({ x:P.x-10+Math.random()*20, y:P.y-PH,
      vx:(Math.random()-0.5)*2, vy:-2-Math.random()*2, life:0.6, r:2+Math.random()*3, color:'#cfe4ff' });
  } else { P.ducking=true; duckT=26; }
}
canvas.addEventListener('pointerdown', e => {
  e.preventDefault();
  AudioMan.unlock();
  const rect=canvas.getBoundingClientRect();
  const cx=(e.clientX-rect.left)*(W/rect.width);
  const cy=(e.clientY-rect.top)*(H/rect.height);
  pointerDown=true; pointerX=cx; pointerY=cy; touchY0=cy; swiped=false;
  dragDX=0; dragDY=0;
  if (cx>W-46 && cy<40) { AudioMan.toggleMute(); return; }
  if (state===ST.CHAR_SELECT) { handleCharSelect(cx); return; }
  if (state===ST.DEAD && deadF>50) { handleDeadButtons(cx,cy); return; }
  if (state===ST.VICTORY && victF>60) { handleVictoryButtons(cx,cy); return; }
  handleAction();
});
canvas.addEventListener('pointermove', e => {
  const rect=canvas.getBoundingClientRect();
  const px=(e.clientX-rect.left)*(W/rect.width);
  const py=(e.clientY-rect.top)*(H/rect.height);
  if (pointerDown) { dragDX+=px-pointerX; dragDY+=py-pointerY; }
  pointerX=px; pointerY=py;
  if (pointerDown && !swiped && pointerY-touchY0>55) { swiped=true; doSlam(); }
});
canvas.addEventListener('pointerup',    () => pointerDown=false);
canvas.addEventListener('pointercancel',() => pointerDown=false);

// pilotaje de nave en 4 direcciones: arrastre relativo (el dedo no tapa
// la nave, que copia el movimiento) + flechas/WASD en teclado
function steerShip(s, xMin, xMax, yMin, yMax) {
  if (pointerDown) { s.tx+=dragDX*1.25; s.ty+=dragDY*1.25; }
  dragDX=0; dragDY=0;
  if (keys['ArrowUp']||keys['KeyW'])    s.ty-=8;
  if (keys['ArrowDown']||keys['KeyS'])  s.ty+=8;
  if (keys['ArrowLeft']||keys['KeyA'])  s.tx-=8;
  if (keys['ArrowRight']||keys['KeyD']) s.tx+=8;
  s.tx=Math.max(xMin,Math.min(xMax,s.tx));
  s.ty=Math.max(yMin,Math.min(yMax,s.ty));
  s.x+=(s.tx-s.x)*0.16;
  s.y+=(s.ty-s.y)*0.16;
}

function handleAction() {
  if (state===ST.LOADING) return;
  if (state===ST.TITLE)   { AudioMan.sfx('ui-click'); state=ST.CHAR_SELECT; return; }
  if (state===ST.STORY)   { advanceStory(); return; }
  if (state===ST.FLY || state===ST.DUEL || state===ST.BOARD) return; // nave: mover con puntero/flechas
  if (state===ST.BOSS && FB) return;   // contra Bubeado pilotas la nave, no saltas
  if ((state===ST.PLAYING || state===ST.BOSS) && !P.dead && P.jumps<2) {
    P.vy = JUMP_VY - P.jumps*1.8;
    P.jumps++;
    misEvent('jump');
    AudioMan.stopRun();
  }
}
function handleCharSelect(cx) {
  const newSel = cx < W/4 ? 0 : cx < W/2 ? 1 : cx < W*3/4 ? 2 : 3;
  if (newSel===2 && !brunoOwned) {
    AudioMan.sfx('ui-back');
    shopMsg='🏆 Recupera la brújula (pásate el juego) para desbloquear a BrunoTube'; shopMsgT=130;
    return;
  }
  if (newSel===3 && !mamaOwned) {
    if (bank>=MAMA_COST) {
      bank-=MAMA_COST; mamaOwned=true; saveMeta();
      selChar=3;
      AudioMan.sfx('gema');
      shopMsg='¡MAMATUBE DESBLOQUEADA!'; shopMsgT=140;
    } else {
      AudioMan.sfx('ui-back');
      shopMsg='Te faltan '+(MAMA_COST-bank)+' monedas · gana monedas jugando'; shopMsgT=110;
    }
    return;
  }
  if (newSel===selChar) {
    AudioMan.sfx('ui-play');
    resetRun();
    storyIdx=0; storyF=0; state=ST.STORY;
    return;
  }
  selChar=newSel;
  AudioMan.sfx('ui-click');
}
function advanceStory() {
  AudioMan.sfx('ui-click');
  storyIdx++; storyF=0;
  if (storyIdx>=3) startWorld(0);
}
function handleDeadButtons(cx,cy) {
  const ry=H/2+104;
  if (!revived && bank>=REVIVE_COST && cy>ry-22 && cy<ry+22 && cx>W/2-135 && cx<W/2+135) {
    reviveNow(); return;
  }
  const by=H/2+150;
  if (cy>by-34 && cy<by+34) {
    if (cx>W/2-120 && cx<W/2-40) { retryWorld(); return; }
    if (cx>W/2+40 && cx<W/2+120) {
      AudioMan.sfx('ui-back');
      state=ST.TITLE;
      AudioMan.music('musica-menu');
      return;
    }
  }
}
function handleVictoryButtons(cx,cy) {
  const by=H-90;
  if (cy>by-30 && cy<by+30) {
    if (cx>W/2-260 && cx<W/2-20) {
      // Otra vuelta: más rápido y más difícil, conservando puntuación
      lap++;
      lives=LIVES; revived=false;
      AudioMan.sfx('ui-play');
      startWorld(0, {fromShip:true});
      return;
    }
    if (cx>W/2+20 && cx<W/2+260) {
      AudioMan.sfx('ui-back');
      if (score>hiScore) { hiScore=score; localStorage.setItem('mk_hi',hiScore); }
      bank += coins - banked; banked=coins; saveMeta();
      state=ST.TITLE;
      AudioMan.music('musica-menu');
      return;
    }
  }
}

