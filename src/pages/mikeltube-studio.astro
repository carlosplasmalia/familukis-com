  }

  // progreso de oleadas
  if (f.phase==='waves') {
    ctx.fillStyle='rgba(0,0,20,0.55)'; roundRect(W/2-160,H-46,320,30,9); ctx.fill();
    ctx.fillStyle='rgba(255,255,255,0.2)'; roundRect(W/2-150,H-38,300,14,7); ctx.fill();
    ctx.fillStyle='#7FDBFF'; roundRect(W/2-150,H-38,300*Math.min(1,f.waveIdx/FLY_WAVES),14,7); ctx.fill();
    ctx.fillStyle='#fff'; ctx.font='bold 13px system-ui,sans-serif'; ctx.textAlign='center';
    ctx.fillText('RUMBO A '+WORLDS[world+1].nombre+'  ·  OLEADA '+Math.min(FLY_WAVES,f.waveIdx)+'/'+FLY_WAVES, W/2, H-52);
    ctx.textAlign='left';
