  // arma activa
  if (f.weapon!=='single') {
    ctx.fillStyle='rgba(0,0,20,0.55)'; roundRect(W-190,52,180,30,9); ctx.fill();
    ctx.fillStyle='#FFDC00'; ctx.font='bold 14px system-ui,sans-serif'; ctx.textAlign='center';
    const nom = f.weapon==='double'?'DOBLE':f.weapon==='spread'?'ABANICO':'METRALLETA';
    ctx.fillText(nom+' '+Math.ceil(f.wTime/60)+'s', W-100, 72);
    ctx.textAlign='left';
  }
}
function drawFlyBoss() {
  const f=F, b=f.boss;

  // mira láser del Robot Nodriza: la línea marca por dónde saldrán los disparos
  if (f.theme===0 && b.phase==='lock') {
    ctx.globalAlpha=0.28+0.18*Math.abs(Math.sin(b.pt*0.2));
    ctx.strokeStyle='#ff5555'; ctx.lineWidth=3;
    ctx.setLineDash([14,10]);
    ctx.beginPath(); ctx.moveTo(b.x-85, b.y); ctx.lineTo(0, b.y); ctx.stroke();
    ctx.setLineDash([]); ctx.lineWidth=1; ctx.globalAlpha=1;
  }
  // avisos de la lluvia de misiles en el borde derecho
  if (f.theme===0 && b.phase==='rainWarn' && b.ys) {
    for (const wy of b.ys) {
      if (Math.floor(b.pt/6)%2===0) di('warn'+(Math.floor(b.pt/5)%6), W-52, wy-22, 44, 44);
    }
  }
  // línea de embestida
  if (f.theme===0 && (b.phase==='dashPrep'||b.phase==='dash')) {
    ctx.globalAlpha=b.phase==='dashPrep'?0.22+0.2*Math.abs(Math.sin(b.pt*0.3)):0.12;
    ctx.fillStyle='#ff6633';
    ctx.fillRect(0, b.y-52, W, 104);
    ctx.globalAlpha=1;
  }

  // mira y láser barredor de la Nave de Gunilda
  if (f.theme===1 && (b.phase==='laserPrep'||b.phase==='laser')) {
    if (b.phase==='laserPrep') {
      ctx.globalAlpha=0.3+0.4*Math.abs(Math.sin(b.pt*0.3));
      ctx.strokeStyle='#ff88ff'; ctx.lineWidth=4;
      ctx.setLineDash([18,12]);
      ctx.beginPath(); ctx.moveTo(b.x-70, b.y); ctx.lineTo(0, b.y); ctx.stroke();
      ctx.setLineDash([]); ctx.lineWidth=1;
      ctx.fillStyle='#ff88ff';
      ctx.beginPath(); ctx.arc(b.x-70, b.y, 12+b.pt*0.45, 0, Math.PI*2); ctx.fill();
      ctx.globalAlpha=1;
    } else if (b.pt<85) {
      const lf=gi('flaser'+(Math.floor(b.pt/3)%5));
      ctx.globalAlpha=0.92;
      if (lf) { for (let x=b.x-70; x>-60; x-=110) ctx.drawImage(lf, x-110, b.y-26, 116, 52); }
      else { ctx.fillStyle='#ff66ff'; ctx.fillRect(0, b.y-20, b.x-70, 40); }
      ctx.globalAlpha=1;
    }
  }

  ctx.save();
  if (b.flash>0) ctx.globalAlpha=0.6;
  if (b.phase==='dashPrep' && Math.floor(b.pt/5)%2===0) ctx.globalAlpha=0.75;
  // llamas de motor detrás de la nave
  {
    const fl=8+Math.sin(gframe*0.5)*4+(b.phase==='dash'?10:0);
    ctx.fillStyle='rgba(255,150,40,0.75)';
    ctx.beginPath(); ctx.ellipse(b.x+(f.theme===0?92:112), b.y-26, fl*1.7, fl*0.55, 0, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(b.x+(f.theme===0?92:112), b.y+26, fl*1.7, fl*0.55, 0, 0, Math.PI*2); ctx.fill();
  }
  if (f.theme===0) {
    const im=gi('bigship1');
    if (im) {
      const hh=250, ww=hh*im.naturalWidth/im.naturalHeight;
      ctx.translate(b.x, b.y);
      ctx.rotate(Math.sin(b.t*0.03)*0.04);
      ctx.drawImage(im, -ww*0.5, -hh*0.5, ww, hh);
    } else { ctx.fillStyle='#99a'; ctx.beginPath(); ctx.arc(b.x, b.y, 90, 0, Math.PI*2); ctx.fill(); }
  } else {
    // halo mágico de bruja (sin shadowBlur: barato en tablets)
    const halo=0.16+0.10*Math.abs(Math.sin(b.t*0.06));
    ctx.fillStyle=`rgba(190,80,255,${halo})`;
    ctx.beginPath(); ctx.arc(b.x, b.y, 122, 0, Math.PI*2); ctx.fill();
    const im=gi('bigship2');
    if (im) {
      const hh=250, ww=hh*im.naturalWidth/im.naturalHeight;
      ctx.translate(b.x, b.y); ctx.rotate(Math.sin(b.t*0.04)*0.06);
      ctx.drawImage(im, -ww*0.5, -hh*0.5, ww, hh);
    } else {
      ctx.fillStyle='#b285e0';
      ctx.beginPath(); ctx.arc(b.x, b.y, 80, 0, Math.PI*2); ctx.fill();
    }
  }
  ctx.restore();
  if (b.phase!=='dying') drawBossBar(b.x, b.y-(f.theme===0?145:150), b.hp, b.maxHp,
    (b.enraged?'🔥 ':'')+(f.theme===0?'NAVE NODRIZA':'NAVE DE GUNILDA'));
  // aviso de embestida
  if (b.phase==='dashPrep' && Math.floor(b.pt/6)%2===0) {
    ctx.fillStyle='#ff4444'; ctx.font='bold 30px system-ui,sans-serif'; ctx.textAlign='center';
    ctx.fillText('¡¡EMBISTE!! ¡Sal de la franja!', W/2, b.y-70);
    ctx.textAlign='left';
  }
}
function drawDuel() {
  drawSpaceBg(1);
  const d=D;
  // Gunilda en escoba
  if (d.phase!=='dying' || d.t<80) {
    const be=gi('BRUJAESCOBA')||gi('gun'+(Math.floor(d.t/6)%3));
    const bimg=gi('brunilda');
    ctx.save();
    if (d.flash>0 && ctx.filter!==undefined) ctx.filter='brightness(2.2)';
    ctx.translate(d.gx, d.gy);
    const tilt=d.phase==='dying'?d.t*0.05:Math.sin(d.t*0.05)*0.12;
    ctx.rotate(tilt);
    ctx.scale(-1,1);
    if (bimg) {
      const gh=120, gw=gh*bimg.naturalWidth/bimg.naturalHeight;
      ctx.drawImage(bimg, -gw*0.5, -gh*0.5, gw, gh);
    }
    ctx.restore();
    if (ctx.filter!==undefined) ctx.filter='none';
    drawBossBar(d.gx, d.gy-95, d.hp, d.maxHp, 'GUNILDA — ¡RECUPERA LA BRÚJULA!');
  }
  for (const b of d.bullets) {
    const bi=gi('bullet');
    if (bi) ctx.drawImage(bi, b.x-16, b.y-8, 32, 16);
  }
  for (const bo of d.bolas) {
    const bi=gi('bola'+bo.af);
    if (bi) ctx.drawImage(bi, bo.x-19, bo.y-19, 38, 38);
  }
  if (gframe%2===0) particles.push({ x:d.x-40, y:d.y+8, vx:-4-Math.random()*2, vy:(Math.random()-0.5)*1.4,
                                     life:0.7, r:2.5+Math.random()*3.5, color:'#ffd27a' });
  drawParticles();
  drawPlayerShip(d.x, d.y, Math.max(-0.2,Math.min(0.2,(d.ty-d.y)*0.006)));
  drawEffects(); drawFloatTexts();
  drawHUD();
}

