function drawCharSelect() {
  const g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,'#040c20'); g.addColorStop(1,'#0a2050');
  ctx.fillStyle=g; ctx.fillRect(0,0,W,H);

  ctx.fillStyle='#fff'; ctx.font='bold 34px system-ui,sans-serif'; ctx.textAlign='center';
  ctx.shadowColor='#0055ff'; ctx.shadowBlur=22;
  ctx.fillText('ELIGE TU PERSONAJE', W/2, 62);
  ctx.shadowBlur=0;

  const cw=170, ch=220, gap=24;
  const totalW=4*cw+3*gap;
  const startX=(W-totalW)/2;
  const my=H/2-ch/2+10;

  const cards=[
    {pose:'mikelPose', name:'nameMikel', label:'MIKEL',     locked:false},
    {pose:'leoPose',   name:'nameLeo',   label:'LEO',       locked:false},
    {pose:'brunoPose', name:null,         label:'BRUNOTUBE', locked:!brunoOwned, kind:'victory'},
    {pose:'mamaPose',  name:null,         label:'MAMATUBE',  locked:!mamaOwned,  kind:'coins'},
  ];

  cards.forEach((c,i)=>{
    const cx=startX+i*(cw+gap);
    const sel=selChar===i;
    ctx.fillStyle=c.locked?'rgba(255,255,255,0.03)':sel?'rgba(255,220,0,0.18)':'rgba(255,255,255,0.06)';
    roundRect(cx-8,my-10,cw+16,ch+86,14); ctx.fill();
    ctx.strokeStyle=c.locked?'#333':sel?'#FFD700':'#445';
    ctx.lineWidth=c.locked?1:sel?3:1.5;
    roundRect(cx-8,my-10,cw+16,ch+86,14); ctx.stroke();
    ctx.lineWidth=1;

    ctx.globalAlpha=c.locked?0.28:1;
    di(c.pose,cx,my,cw,ch);
    ctx.globalAlpha=1;

    if (c.locked) {
      ctx.font='36px system-ui'; ctx.textAlign='center';
      ctx.fillText('🔒', cx+cw/2, my+ch/2+14);
    }

    const ni=gi(c.name);
    if (ni) {
      const nw=130, nh=nw*ni.naturalHeight/ni.naturalWidth;
      ctx.drawImage(ni, cx+cw/2-nw/2, my+ch+12, nw, nh);
    } else {
      ctx.fillStyle=c.locked?'#444':sel?'#FFD700':'#aaa';
      ctx.font=`bold ${sel?18:15}px system-ui,sans-serif`; ctx.textAlign='center';
      ctx.fillText(c.label, cx+cw/2, my+ch+42);
    }

    if (sel && !c.locked) {
      ctx.fillStyle='#fff'; ctx.font='13px system-ui,sans-serif'; ctx.textAlign='center';
      ctx.fillText('¡SELECCIONADO!', cx+cw/2, my+ch+68);
    }
    if (c.locked && c.kind==='coins') {
      const canBuy = bank>=MAMA_COST;
      ctx.fillStyle=canBuy?'#FFD700':'#888'; ctx.font='bold 14px system-ui,sans-serif'; ctx.textAlign='center';
      ctx.fillText('🪙 '+MAMA_COST, cx+cw/2, my+ch+68);
      if (canBuy) {
        ctx.fillStyle='#2ecc40'; ctx.font='bold 12px system-ui,sans-serif';
        ctx.fillText('¡TOCA PARA COMPRAR!', cx+cw/2, my+ch+84);
      }
    }
    if (c.locked && c.kind==='victory') {
      ctx.fillStyle='#FFD700'; ctx.font='bold 13px system-ui,sans-serif'; ctx.textAlign='center';
      ctx.fillText('🏆 PÁSATE EL JUEGO', cx+cw/2, my+ch+68);
      ctx.fillStyle='#aaa'; ctx.font='11px system-ui,sans-serif';
      ctx.fillText('Recupera la brújula', cx+cw/2, my+ch+84);
    }
  });

  ctx.fillStyle='#FFD700'; ctx.font='bold 18px system-ui,sans-serif'; ctx.textAlign='left';
  ctx.fillText('🪙 '+bank, 20, 36);

  if (shopMsgT>0) {
    shopMsgT--;
    ctx.fillStyle=shopMsg.indexOf('DESBLOQUEADA')>=0?'#2ecc40':'#ff7b7b';
    ctx.font='bold 20px system-ui,sans-serif'; ctx.textAlign='center';
    ctx.fillText(shopMsg, W/2, H-52);
  }

  ctx.globalAlpha=0.7+Math.sin(gframe*0.08)*0.3;
  ctx.fillStyle='#fff'; ctx.font='bold 17px system-ui,sans-serif'; ctx.textAlign='center';
  ctx.fillText('Toca un personaje  ·  Toca de nuevo para jugar', W/2, H-22);
  ctx.globalAlpha=1;
  ctx.textAlign='left';
  drawMuteBtn();
}

